{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "types": ["node"], "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "site/src/lib/**/*.ts", "functions/**/*.ts"]
}
