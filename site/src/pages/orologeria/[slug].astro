---
import Layout from '../../layouts/Layout.astro';
import { directory, businessUrl, placeOf, localityUrl } from '../../lib/directory';
import { services, statuses, isUsableCoordinate, type Business } from '../../lib/schema';
export function getStaticPaths() { return directory.attivita.map(b => ({ params: { slug: b.slug }, props: { business: b } })); }
interface Props { business: Business; }
const { business: b } = Astro.props;
const place = placeOf(b);
const sources = directory.fonti.filter(s => b.attendibilita.fonti.includes(s.id));
const isLegacy = b.origine.sistema === 'legacy-8dc29a5';
const labels = (ids: string[]) => ids.map(id => directory.fonti.find(s => s.id === id)).filter(s => s !== undefined);
const roles = {
  assistenzaUfficiale: 'Assistenza ufficialmente autorizzata',
  rivenditaUfficiale: 'Rivendita ufficialmente autorizzata',
  riparati: 'Marchi riparati',
  esperienza: 'Esperienza dichiarata',
  venduti: 'Marchi venduti',
  menzionati: 'Marchi citati nelle fonti storiche',
} as const;
const populatedRoles = (Object.entries(roles) as [keyof typeof roles, string][])
  .map(([key, label]) => ({ key, label, claims: b.marchi[key] }))
  .filter(r => r.claims.length > 0);
const hasBrands = populatedRoles.length > 0;
const hasHistory = Boolean(b.storia.testo || b.storia.annoFondazione || b.storia.fondatore || b.storia.eventi.length > 0);
const hasServices = b.servizi.length > 0 || b.altriServizi.length > 0 || b.specializzazioni.length > 0;
const hasUsableCoords = isUsableCoordinate(b.posizione.coordinate);
const hasDirectContact = Boolean(b.contatti.telefono || b.contatti.sito || b.contatti.email || b.contatti.whatsapp);
const telHref = b.contatti.telefono ? `tel:${b.contatti.telefono.replace(/[^+\d]/g, '')}` : null;
const whatsappHref = b.contatti.whatsapp ? `https://wa.me/${b.contatti.whatsapp.replace('+', '')}` : null;
const osmVerifiedHref = hasUsableCoords && b.posizione.coordinate
  ? `https://www.openstreetmap.org/?mlat=${b.posizione.coordinate.lat}&mlon=${b.posizione.coordinate.lon}#map=17/${b.posizione.coordinate.lat}/${b.posizione.coordinate.lon}`
  : null;
const osmSearchHref = !hasUsableCoords && b.posizione.indirizzo
  ? `https://www.openstreetmap.org/search?query=${encodeURIComponent(`${b.posizione.indirizzo}, ${place.comune}, Italia`)}`
  : null;

const lacune: string[] = [];
if (!hasDirectContact) lacune.push('recapiti diretti verificati');
else {
  if (!b.contatti.telefono) lacune.push('telefono');
  if (!b.contatti.sito) lacune.push('sito web');
}
if (b.orari.giorni.length === 0) lacune.push('orari di apertura');
if (!hasBrands) lacune.push('marchi trattati');
if (!hasHistory) lacune.push('storia dell’attività');
if (!hasUsableCoords) lacune.push('coordinate cartografiche verificate');

const schema = { '@context': 'https://schema.org', '@type': 'WebPage', name: b.nome, description: b.descrizione, url: new URL(businessUrl(b), Astro.site).href };
const report = `mailto:acquistiscardi@gmail.com?subject=${encodeURIComponent(`Correzione scheda: ${b.id}`)}&body=${encodeURIComponent(`Scheda: https://orologiai.it${businessUrl(b)}\nRuolo (titolare, cliente, altro):\nDato da correggere:\nFonte pubblica:\n`)}`;
const aggiornamento = `mailto:acquistiscardi@gmail.com?subject=${encodeURIComponent(`Aggiornamento scheda: ${b.id}`)}&body=${encodeURIComponent(`Scheda: https://orologiai.it${businessUrl(b)}\nSono il titolare o mi occupo dell’attività.\nAggiornamento da apportare:\nFonte pubblica che lo conferma:\n`)}`;
const contestazione = `mailto:acquistiscardi@gmail.com?subject=${encodeURIComponent(`Contestazione dato non documentato: ${b.id}`)}&body=${encodeURIComponent(`Scheda: https://orologiai.it${businessUrl(b)}\nInformazione contestata:\nPerché non è documentata o è errata:\n`)}`;
const assistenteQuery = `/orologiaio/?q=${encodeURIComponent(`Cerco informazioni su ${b.nome} a ${place.comune}`)}`;
---
<Layout title={`${b.nome} — ${place.comune}`} description={b.descrizione} schema={schema}>
  <section class="page-hero profile-hero">
    <div class="container">
      <a class="breadcrumb" href={localityUrl(place)}>← {place.comune} ({place.siglaProvincia}), {place.regione}</a>
      <div class="profile-hero-meta">
        <p class="eyebrow">Scheda attività · {b.tipi.join(' / ')} · {place.comune} ({place.siglaProvincia})</p>
        <span class="status">{statuses[b.attendibilita.stato]}</span>
      </div>
      <h1>{b.nome}</h1>
      <p class="lead">{b.descrizione}</p>

      <div class="profile-summary-bar" aria-label="Informazioni principali e contatti rapidi">
        <div class="profile-summary-location">
          <strong>{place.comune} ({place.siglaProvincia}) · {place.regione}</strong>
          <span>{b.posizione.indirizzo ? `${b.posizione.indirizzo}${b.posizione.cap ? ` · ${b.posizione.cap}` : ''}` : 'Indirizzo civico non ancora verificato'}</span>
        </div>
        {b.servizi.length > 0 && (
          <div class="profile-hero-tags" aria-label="Servizi principali documentati">
            {b.servizi.map(s => <span class="tag tag-hero">{services[s.id]}</span>)}
          </div>
        )}
        <div class="profile-actions" role="group" aria-label="Azioni principali">
          {telHref && <a class="btn action-primary" href={telHref}>Chiama {b.contatti.telefono}</a>}
          {b.contatti.sito && <a class="btn action-secondary" href={b.contatti.sito} rel="noreferrer">Visita il sito ufficiale ↗</a>}
          {b.contatti.email && <a class="btn action-secondary" href={`mailto:${b.contatti.email}`}>Scrivi email</a>}
          {whatsappHref && <a class="btn action-secondary" href={whatsappHref} rel="noreferrer">WhatsApp ↗</a>}
          {osmVerifiedHref && <a class="btn action-outline" href={osmVerifiedHref} rel="noreferrer">Apri posizione verificata su mappa ↗</a>}
          {osmSearchHref && <a class="btn action-outline" href={osmSearchHref} rel="noreferrer">Cerca l’indirizzo sulla mappa ↗</a>}
          <a class="btn action-ghost" href={aggiornamento}>Segnala un aggiornamento</a>
        </div>
        {osmSearchHref && <p class="profile-map-disclaimer">Il collegamento alla mappa avvia una ricerca testuale dell’indirizzo su OpenStreetMap: non rappresenta una coordinata già verificata.</p>}
      </div>
    </div>
  </section>

  <nav class="profile-subnav" aria-label="Sezioni della scheda">
    <div class="container profile-subnav-inner">
      <a href="#panoramica">1. Panoramica e contatti</a>
      <a href="#servizi-competenze">2. Servizi e competenze</a>
      {hasBrands && <a href="#marchi-trattati">3. Marchi trattati</a>}
      {hasHistory && <a href="#storia">4. Storia</a>}
      <a href="#fonti">5. Fonti e verifiche</a>
    </div>
  </nav>

  <div class="container section profile-grid">
    <aside id="panoramica" class="profile-aside">
      <section class="panel contact-panel">
        <p class="eyebrow dark">1 · Panoramica e recapiti</p>
        <h2>Dove e come contattare l’attività</h2>
        <address class="contact-address">
          <strong>{b.nome}</strong><br />
          {b.posizione.indirizzo ?? 'Indirizzo non disponibile'}<br />
          {b.posizione.cap} {place.comune} ({place.siglaProvincia}) · {place.regione}
        </address>

        {hasDirectContact ? (
          <dl class="contact-list">
            {b.contatti.telefono && (
              <div>
                <dt>Telefono</dt>
                <dd><a href={telHref!}>{b.contatti.telefono}</a></dd>
              </div>
            )}
            {b.contatti.sito && (
              <div>
                <dt>Sito ufficiale</dt>
                <dd><a href={b.contatti.sito} rel="noreferrer">{b.contatti.sito.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} ↗</a></dd>
              </div>
            )}
            {b.contatti.email && (
              <div>
                <dt>Email</dt>
                <dd><a href={`mailto:${b.contatti.email}`}>{b.contatti.email}</a></dd>
              </div>
            )}
            {b.contatti.whatsapp && (
              <div>
                <dt>WhatsApp</dt>
                <dd><a href={whatsappHref!} rel="noreferrer">{b.contatti.whatsapp} ↗</a></dd>
              </div>
            )}
          </dl>
        ) : (
          <p class="notice compact-notice">Nessun recapito telefonico o sito web confermato nel database per questa scheda storica. Puoi verificare l’indirizzo o proporre un aggiornamento documentato.</p>
        )}

        {b.orari.giorni.length > 0 ? (
          <div class="contact-hours">
            <h3>Orari riscontrati</h3>
            <ul>
              {b.orari.giorni.map(g => (
                <li>
                  <span>{['Lunedì','Martedì','Mercoledì','Giovedì','Venerdì','Sabato','Domenica'][g.giorno - 1]}</span>
                  <strong>{g.intervalli.length ? g.intervalli.map(i => `${i.apertura}–${i.chiusura}`).join(', ') : 'chiuso'}</strong>
                </li>
              ))}
            </ul>
            {b.orari.verificatiIl && <p class="small muted">Orari riscontrati nella fonte il {b.orari.verificatiIl}. Confermare eventuali variazioni o festività; non mostriamo “aperto oggi”.</p>}
          </div>
        ) : (
          <p class="small muted contact-hours-missing">Orari non disponibili nel database: non possiamo indicare se l’attività è aperta oggi. Contatta l’attività prima di metterti in viaggio.</p>
        )}

        <div class="contact-map-box">
          {hasUsableCoords && b.posizione.coordinate ? (
            <>
              <p class="small"><strong>Posizione geocodificata e confrontata con l’indirizzo disponibile.</strong> Non equivale a una verifica sul posto.</p>
              <a class="btn btn-ghost small-btn" href={osmVerifiedHref!} rel="noreferrer">Apri la posizione su OpenStreetMap ↗</a>
            </>
          ) : (
            <>
              <p class="small muted">Nessuna posizione cartografica pubblicata: l’indirizzo non è ancora confrontato con una geocodifica verificata.</p>
              {osmSearchHref && (
                <p class="small">
                  <a href={osmSearchHref} rel="noreferrer">Cerca l’indirizzo su OpenStreetMap ↗</a>
                  <span class="muted"> (ricerca testuale esterna, non un punto verificato)</span>
                </p>
              )}
            </>
          )}
        </div>

        <details class="owner-actions">
          <summary>È la tua attività o vuoi segnalare una correzione?</summary>
          <p class="small">Proponi un aggiornamento allegando fonti pubbliche: ogni modifica viene verificata prima della pubblicazione.</p>
          <ul class="small">
            <li><a href={aggiornamento}>Aggiorna la scheda della tua attività →</a></li>
            <li><a href={contestazione}>Contesta un dato non documentato →</a></li>
            <li><a href="/privacy/#come-esercitare-i-diritti">Rettifica o cancellazione dei dati personali →</a></li>
          </ul>
          <p class="small muted">Si risponde via email, senza creare un account. <a href="/partecipa/">Come funziona la revisione →</a></p>
        </details>
      </section>
    </aside>

    <div class="profile-main">
      <section class="panel" id="servizi-competenze">
        <p class="eyebrow dark">2 · Competenze documentate</p>
        <h2>Servizi e specializzazioni</h2>
        {hasServices ? (
          <>
            {b.servizi.length > 0 && (
              <ul class="service-source-list">
                {b.servizi.map(s => (
                  <li>
                    <strong>{services[s.id]}</strong>
                    <span class="source-badges">
                      {labels(s.fonti).map(f => <a href={f.url} rel="noreferrer">fonte: {f.titolo}</a>)}
                    </span>
                  </li>
                ))}
              </ul>
            )}
            {b.specializzazioni.length > 0 && (
              <div class="profile-specializations">
                <h3>Ambiti e specializzazioni</h3>
                <div class="tags">
                  {b.specializzazioni.map(sp => <span class="tag">{sp.id}</span>)}
                </div>
              </div>
            )}
            {b.altriServizi.length > 0 && (
              <div class="profile-other-services">
                <h3>Ulteriori lavorazioni citate nelle fonti</h3>
                <ul>{b.altriServizi.map(s => <li>{s.nome}</li>)}</ul>
              </div>
            )}
            <p class="small muted">Presenti nelle fonti citate; disponibilità effettiva, tempi e modalità (in sede o laboratorio esterno) vanno confermati direttamente con l’attività.</p>
          </>
        ) : (
          <p class="small muted">Nessuno specifico servizio di laboratorio o vendita è dettagliato nel database oltre alla categoria generale ({b.tipi.join(', ')}). Contatta direttamente l’attività per verificare le lavorazioni eseguite.</p>
        )}
      </section>

      {hasBrands && (
        <section class="panel" id="marchi-trattati">
          <p class="eyebrow dark">3 · Relazione con i marchi</p>
          <h2>Marchi trattati</h2>
          <div class="brand-roles-grid">
            {populatedRoles.map(({ label, claims }) => (
              <div class="fact">
                <h3>{label}</h3>
                <ul>
                  {claims.map(c => (
                    <li>
                      <strong>{c.marca}</strong>
                      <small> — {labels(c.fonti).map(f => <a href={f.url} rel="noreferrer">fonte</a>)}</small>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <p class="notice">La citazione di un marchio non prova un’autorizzazione ufficiale, né alla vendita né all’assistenza. Le categorie di relazione con i marchi prive di riscontri documentati non vengono mostrate.</p>
        </section>
      )}

      {hasHistory && (
        <section class="panel" id="storia">
          <p class="eyebrow dark">4 · Memoria delle botteghe</p>
          <h2>La storia</h2>
          {b.storia.testo && <p>{b.storia.testo}</p>}
          {b.storia.annoFondazione && <p>Anno riportato dalle fonti: <strong>{b.storia.annoFondazione}</strong>.</p>}
          {b.storia.eventi.length > 0 && (
            <ul>
              {b.storia.eventi.map(ev => <li><strong>{ev.data}:</strong> {ev.descrizione}</li>)}
            </ul>
          )}
          <p class="small muted">{isLegacy ? 'Informazioni provenienti dall’archivio storico, non riconfermate sul sito ufficiale attuale salvo ove indicato nelle fonti.' : 'I fatti storici riportati sono attribuiti alle fonti citate. La consultazione online non equivale a un controllo archivistico indipendente.'}</p>
        </section>
      )}

      {lacune.length > 0 && (
        <section class="panel missing-summary-panel" aria-label="Informazioni non ancora disponibili">
          <h2>Informazioni non ancora disponibili</h2>
          <p>Alcuni dettagli su questa attività non sono ancora disponibili nel database (<strong>{lacune.join(', ')}</strong>). Non mostriamo sezioni vuote né trasformiamo l’assenza di dati in una conferma implicita: puoi consultare le fonti qui sotto o <a href={aggiornamento}>proporre un aggiornamento documentato</a>.</p>
          {!hasBrands && <p class="small muted">La scheda non elenca ancora marchi specifici verificati: ciò non esclude che l’attività tratti o ripari orologi di diverse marche.</p>}
        </section>
      )}

      <section class="panel" id="fonti">
        <p class="eyebrow dark">5 · Trasparenza e tracciabilità</p>
        <h2>Fonti e verifiche</h2>
        <p>
          Stato: <strong>{statuses[b.attendibilita.stato]}</strong> ·
          Raccolta: <time datetime={b.attendibilita.raccoltaIl}>{b.attendibilita.raccoltaIl}</time> ·
          Verifica indipendente: {b.attendibilita.verificataIl ?? 'non ancora eseguita'} ·
          Conferma titolare: {b.attendibilita.confermataTitolareIl ?? 'non ricevuta'}.
        </p>
        <ul>
          {sources.map(s => (
            <li>
              <a href={s.url} rel="noreferrer">{s.titolo}</a> · consultazione {s.consultataIl}
              {s.percorsoArchivio && <span> · archivio conservato: <code>{s.percorsoArchivio}</code></span>}
            </li>
          ))}
        </ul>
        <details>
          <summary>Cronologia della scheda ({b.attendibilita.cronologia.length})</summary>
          <ul>{b.attendibilita.cronologia.map(e => <li>{e.data} — {e.azione}</li>)}</ul>
        </details>
        <div class="profile-footer-links">
          <a class="text-link" href={report}>Segnala un’informazione errata →</a>
          <a class="text-link" href={assistenteQuery}>Cerchi alternative a {place.comune}? Chiedi alla Ricerca guidata →</a>
        </div>
      </section>
    </div>
  </div>
</Layout>
