---
import Layout from '../../layouts/Layout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import { directory, brandNames, slugify } from '../../lib/directory';
import { brandKey, brandLabel } from '../../lib/schema';
export function getStaticPaths() { return [...new Map(brandNames.map(name => [slugify(name), name])).entries()].map(([marca,name]) => ({ params: { marca }, props: { name } })); }
interface Props { name: string; }
const { name } = Astro.props;
const label=brandLabel(name);
const editorial:Record<string,{year:number;place:string;summary:string;url:string;dateLabel?:string}>={"iwc":{"year":1868,"place":"Sciaffusa, Svizzera","summary":"Florentine Ariosto Jones fondò la International Watch Company a Sciaffusa nel 1868. La maison ha sviluppato una tradizione di orologi da aviatore e complicazioni meccaniche.","url":"https://www.iwc.com/eu-it/company/history"},"jaeger-lecoultre":{"year":1833,"place":"Vallée de Joux, Svizzera","summary":"Le origini della manifattura risalgono al 1833 nella Vallée de Joux. La sua identità è legata alla precisione dei movimenti e allo sviluppo delle complicazioni.","url":"https://www.jaeger-lecoultre.com/us-en/our-maison/our-identity/190-years"},"baume-mercier":{"year":1830,"place":"Les Bois, Giura svizzero","summary":"La storia prende avvio nel 1830 con l'atelier di Louis Joseph Baume a Les Bois. Il marchio Baume & Mercier fu registrato nel 1920.","url":"https://www.baume-et-mercier.com/it/it/chi-siamo/storia.html"},"vulcain":{"year":1858,"place":"Svizzera","summary":"Fondata nel 1858, Vulcain è conosciuta per il Cricket, un orologio da polso con sveglia meccanica.","url":"https://vulcain.ch/pages/history-of-vulcain"},"panerai":{"year":1860,"place":"Firenze, Italia","summary":"La storia di Panerai inizia nel 1860 con la bottega di Giovanni Panerai a Firenze, che ospitava anche un laboratorio e una scuola di orologeria.","url":"https://www.panerai.com/ch/en/world-of-panerai/history.html"},"rolex":{"year":1905,"place":"Londra, Regno Unito","summary":"Le origini di Rolex risalgono alla società avviata da Hans Wilsdorf nel 1905. Nel 1926 arrivò la cassa Oyster, progettata per proteggere il movimento da acqua e polvere; Montres Rolex S.A. fu registrata a Ginevra nel 1920.","url":"https://newsroom.rolex.com/about-rolex/history-of-rolex"},"hamilton":{"year":1892,"place":"Lancaster, Pennsylvania, Stati Uniti","summary":"Hamilton nacque a Lancaster nel 1892 e si dedicò agli orologi da tasca di precisione utilizzati nelle ferrovie americane. La storia del marchio comprende successivamente orologi elettrici e digitali.","url":"https://www.hamiltonwatch.com/en-int/about-hamilton-watch"},"longines":{"year":1832,"place":"Saint-Imier, Svizzera","summary":"La storia di Longines comincia a Saint-Imier nel 1832 con l’impresa di Auguste Agassiz. La maison conserva nella stessa località un museo dedicato al proprio patrimonio orologiero.","url":"https://www.longines.com/universe"},"omega":{"year":1848,"place":"Svizzera","summary":"Louis Brandt realizzò i primi orologi nel 1848. La ricerca della precisione dei movimenti è un filo conduttore della storia di Omega, che comprende la moderna certificazione Master Chronometer.","url":"https://press.omegawatches.com/omega-celebrates-10-years-of-master-chronometer-certification/"},"tissot":{"year":1853,"place":"Le Locle, Svizzera","summary":"La famiglia Tissot avviò nel 1853 un laboratorio di assemblaggio a Le Locle. La collezione Le Locle del 2003 ricordava il centocinquantesimo anniversario del marchio.","url":"https://www.tissotwatches.com/en-ca/magazine-news-beginnings-le-locle.html"},"seiko":{"year":1881,"place":"Tokyo, Giappone","summary":"Kintaro Hattori aprì nel 1881 un negozio di vendita e riparazione di orologi a Tokyo. Nel 1913 la sua impresa realizzò il Laurel, il primo orologio da polso giapponese.","url":"https://www.seikowatches.com/global-en/special/heritage/"},"cartier":{"year":1904,"place":"","summary":"Nel 1904 Louis Cartier ideò un orologio da polso per l’aviatore Alberto Santos-Dumont, affinché potesse consultare l’ora durante il volo. Da questa collaborazione deriva la linea Santos; la data indica una tappa dell’orologeria Cartier, non la fondazione della maison.","url":"https://int.cartier.com/en/collections/watches/choose-your-watch/by-material/steel-watches/wssa0086-santos-dumont-watch.html","dateLabel":"Tappa orologiera"},"breitling":{"year":1884,"place":"Svizzera","summary":"La storia di Breitling risale al 1884 e all’attività di Léon Breitling, orientata alla misurazione del tempo e agli strumenti cronografici.","url":"https://www.breitling.com/it-it/about/history/"},"tag-heuer":{"year":1860,"place":"Saint-Imier, Svizzera","summary":"Édouard Heuer avviò la propria impresa orologiera nel 1860. Il suo percorso è caratterizzato dallo sviluppo di strumenti di cronometraggio e cronografi.","url":"https://www.tagheuer.com/ie/en/our-story/history.html"},"citizen":{"year":1918,"place":"Giappone","summary":"Le radici di Citizen risalgono all’istituto di ricerca Shokosha del 1918, che nel 1924 presentò un orologio da tasca. La Citizen Watch Company nacque nel 1930.","url":"https://www.citizenwatch-global.com/about/history/index.html"},"zenith":{"year":1865,"place":"Svizzera","summary":"Nel 1865 Georges Favre-Jacot avviò la manifattura Zenith, riunendo le diverse professioni dell’orologeria in un’organizzazione produttiva integrata.","url":"https://www.zenith-watches.com/en_us/brand/heritage"},"mido":{"year":1918,"place":"Svizzera","summary":"Mido risale al 1918. Il nome richiama l’espressione spagnola «yo mido», misuro; tra le tappe storiche documentate dalla maison figura la linea Multifort.","url":"https://www.midowatches.com/it/mido-universe-history"},"rado":{"year":1917,"place":"Lengnau, Svizzera","summary":"Rado trae origine dalla fabbrica Schlup & Co. del 1917. Il DiaStar del 1962 e il successivo impiego della ceramica tecnica sono tappe della ricerca sui materiali.","url":"https://www.rado.com/swiss-made.html"},"audemars-piguet":{"year":1875,"place":"Le Brassus, Svizzera","summary":"La manifattura Audemars Piguet nacque nel 1875 a Le Brassus, nella Vallée de Joux. La sua storia è legata alla tradizione artigianale della valle e al laboratorio originario.","url":"https://www.audemarspiguet.com/it/about/origins"}};
const info=editorial[slugify(label)]??editorial[slugify(name)]??(brandKey(name)===brandKey('IWC')?editorial.iwc:null);
const groups = { assistenzaUfficiale: 'Assistenza ufficialmente autorizzata', rivenditaUfficiale: 'Rivendita ufficialmente autorizzata', riparati: 'Riparazione documentata', venduti: 'Vendita documentata', esperienza: 'Esperienza dichiarata', menzionati: 'Menzioni nelle fonti storiche' };
const sections=Object.entries(groups).map(([key,title])=>({key,title,records:directory.attivita.filter(b=>b.attendibilita.stato!=='chiusa'&&b.marchi[key as keyof typeof b.marchi].some(c=>brandKey(c.marca)===brandKey(name)))}));
const total=new Set(sections.flatMap(g=>g.records.map(b=>b.id))).size;
---
<Layout title={`${label} — storia, informazioni e assistenza`} description={`Scopri il marchio ${label}, le informazioni disponibili e i professionisti italiani con relazioni documentate.`}>
<section class="brand-atlas-hero"><div class="container"><a class="brand-atlas-back" href="/marchi/">← Tutti i marchi</a><p class="brand-kicker">ATLANTE DEI MARCHI / OROLOGIAI.IT</p><h1>{label}</h1><p>Conosci il marchio. Scopri dove trovare assistenza, riparazioni e rivenditori.</p>{info&&<div class="brand-meta"><span>{info.dateLabel??'Origini'} <strong>{info.year}</strong></span>{info.place&&<span>Luogo <strong>{info.place}</strong></span>}</div>}<nav class="brand-nav" aria-label="Sezioni del marchio"><a href="#il-marchio">Il marchio</a><a href="#professionisti">Trova assistenza e rivenditori</a></nav></div></section>
<section class="container section brand-atlas-body"><article id="il-marchio" class="brand-info-panel"><p class="brand-kicker">01 / IDENTITÀ</p><h2>Conosci {label}</h2>{info?<><p>{info.summary}</p><a class="btn" href={info.url} rel="noopener noreferrer" target="_blank">Storia sul sito ufficiale ↗</a><p class="small muted">Fonte: storia pubblicata dal marchio, consultata il 27 novembre 2026.</p></>:<p>La guida raccoglie le relazioni documentate con questo marchio. La storia editoriale non è ancora disponibile; non attribuiamo origini o caratteristiche senza fonti.</p>}{slugify(label)==='panerai'&&<details class="brand-archive-photo"><summary>Apri una fotografia storica della bottega Panerai</summary><p>Immagine d’archivio: secondo la scheda di Wikimedia Commons raffigura la bottega Panerai nel 1860. Non rappresenta l’attività attuale. Aprendola si carica un’immagine da Wikimedia Commons.</p><figure><img data-archive-src="https://upload.wikimedia.org/wikipedia/commons/b/b9/Panerai_1860.jpg" width="360" height="580" alt="Fotografia storica in bianco e nero della facciata della bottega Panerai" referrerpolicy="no-referrer"/><figcaption>Autore sconosciuto · <a href="https://commons.wikimedia.org/wiki/File:Panerai_1860.jpg">Fonte e attribuzione</a> · <a href="https://creativecommons.org/publicdomain/mark/1.0/">Pubblico dominio</a></figcaption></figure><noscript><a href="https://commons.wikimedia.org/wiki/File:Panerai_1860.jpg">Visualizza su Wikimedia Commons</a></noscript></details>}</article>
<section id="professionisti" class="brand-professionals"><p class="brand-kicker">02 / PROFESSIONISTI IN ITALIA</p><h2>Hai bisogno di assistenza per {label}?</h2><p>{total} attività nella guida con almeno una relazione documentata. Le diverse relazioni non sono equivalenti.</p><div class="brand-role-grid">{sections.filter(g=>g.records.length>0).map(g=><a href={`#ruolo-${g.key}`}><strong>{g.records.length}</strong><span>{g.title}</span><span aria-hidden="true">↓</span></a>)}</div><a class="btn" href={`/cerca/?marca=${encodeURIComponent(label)}`}>Filtra per città e servizio ↗</a><p class="notice">Le autorizzazioni ufficiali richiedono una fonte attuale del marchio. Il solo archivio storico non è sufficiente.</p>{sections.map(g=><details class="brand-group" id={`ruolo-${g.key}`}><summary>{g.title} <span>{g.records.length} attività</span></summary>{g.records.length?<><ul class="grid">{g.records.slice(0,6).map(b=><BusinessCard business={b}/>)}</ul><a class="btn secondary" href={`/cerca/?marca=${encodeURIComponent(label)}&ruoloMarca=${g.key}`}>Vedi tutte le attività per questo ruolo ↗</a></>:<p class="muted">Nessuna attività documentata per questo ruolo nel database attuale.</p>}</details>)}</section></section>
<script>const reveal=()=>{const id=location.hash.slice(1);if(id.startsWith('ruolo-')){const node=document.getElementById(id);if(node instanceof HTMLDetailsElement)node.open=true;}};window.addEventListener('hashchange',reveal);reveal();for(const detail of document.querySelectorAll<HTMLDetailsElement>('.brand-archive-photo'))detail.addEventListener('toggle',()=>{if(!detail.open)return;const img=detail.querySelector<HTMLImageElement>('[data-archive-src]');if(img&&!img.src&&img.dataset.archiveSrc)img.src=img.dataset.archiveSrc;});</script>
</Layout>
<style is:global>
.brand-atlas-hero{background:linear-gradient(130deg,#142f27,#28493b);color:#fffdf8;padding:clamp(34px,6vw,82px) 0}.brand-atlas-back{color:#e6d4ae;font-size:.82rem}.brand-kicker{font:700 .68rem/1.5 system-ui,sans-serif;letter-spacing:.14em;color:#805b2e;margin:16px 0 10px}.brand-atlas-hero .brand-kicker{color:#c5ab7c}.brand-atlas-hero h1{font-size:clamp(3rem,7vw,6rem);font-weight:400;line-height:1.03;overflow-wrap:anywhere;margin:12px 0;color:#fffdf8}.brand-atlas-hero p:not(.brand-kicker){max-width:52ch;color:#e7e7db}.brand-meta,.brand-nav{display:flex;gap:12px 22px;flex-wrap:wrap;margin-top:20px}.brand-meta span{display:flex;flex-direction:column;font-size:.78rem;color:#d7c5a3}.brand-meta strong{font:400 1.5rem Georgia,serif;color:#fffdf8}.brand-nav a{color:#fffdf8;border:1px solid #91a392;padding:12px 16px;text-decoration:none;min-height:44px}.brand-atlas-body{display:grid;gap:24px}.brand-info-panel,.brand-professionals{background:#fffdf8;border:1px solid #d7d7c9;padding:clamp(20px,4vw,38px);border-radius:5px}.brand-info-panel p:not(.brand-kicker){max-width:75ch}.brand-atlas-body h2{font-size:clamp(1.8rem,3.4vw,3rem);margin:0 0 16px}.brand-role-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(170px,100%),1fr));gap:9px;margin:20px 0}.brand-role-grid a{display:grid;gap:8px;border:1px solid #d7d7c9;padding:14px;background:#e4eae0;text-decoration:none;font-size:.83rem;min-width:0}.brand-role-grid strong{font:400 2rem Georgia,serif}.brand-group{border-top:1px solid #d7d7c9;padding:12px 0}.brand-group summary{cursor:pointer;min-height:44px;font-weight:700;padding:10px 0}.brand-group summary span{font-size:.8rem;color:#53675d;margin-left:9px;font-weight:400}.brand-group .grid{margin-block:18px}.brand-atlas-body [id]{scroll-margin-top:20px}@media(max-width:700px){.brand-atlas-body{padding-block:18px}.brand-role-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.brand-role-grid a{padding:10px;overflow-wrap:anywhere}}
</style>

<style is:global>.brand-archive-photo{border-top:1px solid var(--line);margin-top:22px;padding-top:12px}.brand-archive-photo summary{font-weight:700;cursor:pointer}.brand-archive-photo figure{margin:18px 0}.brand-archive-photo img{display:block;width:min(100%,360px);height:auto}.brand-archive-photo figcaption{font-size:.78rem;color:var(--muted);margin-top:8px}</style>
