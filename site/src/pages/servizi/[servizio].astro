---
import Layout from '../../layouts/Layout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import { directory, servicePages } from '../../lib/directory';
import { services } from '../../lib/schema';
export function getStaticPaths() { return servicePages.map(id => ({ params: { servizio: id }, props: { id } })); }
interface Props { id: keyof typeof services; }
const { id } = Astro.props;
const records = directory.attivita.filter(b => b.servizi.some(s => s.id === id));
const advice: Partial<Record<keyof typeof services, string>> = {
 vendita: 'Prima di scegliere un orologio, chiedi informazioni su condizioni, garanzia e assistenza successiva. La presenza di un marchio in una fonte storica non prova una concessione ufficiale attuale.',
 riparazione: 'Descrivi il difetto, il modello e gli eventuali interventi precedenti. Chiedi un preventivo e verifica chi eseguirà il lavoro: un servizio generico di riparazione non documenta automaticamente competenza su ogni meccanismo.',
 assistenza: 'Assistenza è una categoria generale: non significa necessariamente centro autorizzato di un marchio. Per un intervento in garanzia verifica sempre la rete ufficiale del produttore.',
 gioielleria: 'Una gioielleria può affiancare la vendita di orologi ad altri prodotti. Non presumere che disponga di un laboratorio di riparazione: consulta i servizi documentati nella singola scheda.',
 revisione: 'La revisione riguarda la messa a punto del movimento, ma procedure e ricambi variano con modello e condizioni. Chiedi un preventivo, quali interventi sono inclusi e se il lavoro è eseguito in sede o affidato a un laboratorio esterno.',
 cinturini: 'Per sostituire un cinturino occorre verificare attacco, misura e compatibilità con cassa e chiusura. Una vendita di orologi non dimostra questo servizio: qui compaiono solo le attività che lo documentano.',
 manutenzione: 'La manutenzione può comprendere controlli e interventi diversi: non equivale sempre a una revisione completa. Descrivi il tuo orologio e chiedi cosa comprende il servizio e a chi viene affidato.',
 'vendita-nuovi': 'Per un orologio nuovo controlla condizioni di garanzia, documentazione e assistenza successiva. La presenza di un marchio nel catalogo non è da sola una prova di rivendita ufficialmente autorizzata.',
 'vendita-usati': 'Per il secondo polso verifica condizioni, provenienza documentale, controlli effettuati e garanzia del venditore. Un modello descritto come vintage non è automaticamente un orologio usato: riportiamo solo offerte documentate.',
 batterie: 'Per un cambio batteria comunica modello e caratteristiche di impermeabilità. Chiedi se sono previsti controllo delle guarnizioni e prova di tenuta: non sono inclusi automaticamente in ogni sostituzione.',
 pendoleria: 'Pendole e orologi da parete possono richiedere competenze e modalità di trasporto differenti rispetto agli orologi da polso. Prima di spostarli chiedi se sono disponibili sopralluogo, ritiro o intervento sul posto.',
 'acquisto-permuta': 'Questa categoria comprende attività che documentano acquisto, compravendita o permuta. La singola scheda precisa il caso: non tutte offrono scambio, conto vendita o acquisto di ogni marca. Chiedi modalità e condizioni prima di consegnare un orologio.',
 lucidatura: 'La lucidatura modifica le superfici e va valutata in rapporto a finiture, materiale e valore storico. Prima di autorizzarla chiedi quali parti saranno trattate e se è preferibile una conservazione delle finiture esistenti.',
};
---
<Layout title={`${services[id]} — attività censite`} description={`${services[id]}: consulta le attività che riportano questo servizio nelle fonti e controlla i dettagli prima di contattarle.`}>
<section class="page-hero"><div class="container"><p class="eyebrow">Cerca per esigenza</p><h1>{services[id]}</h1><p class="lead">{advice[id] ?? 'Consulta le fonti della singola attività e conferma direttamente disponibilità e condizioni del servizio.'}</p></div></section>
<section class="container section"><h2>{records.length} attività con questo servizio nelle fonti</h2><p class="notice">Indicazioni da fonti storiche e siti ufficiali: ogni scheda mostra il proprio stato e la data di verifica. Non sono preventivi; conferma direttamente disponibilità e condizioni del servizio.</p><ul class="grid">{records.map(b => <BusinessCard business={b} />)}</ul><a class="btn" href={`/cerca/?servizio=${id}`}>Affina per località e altri criteri →</a></section>
</Layout>
