---
import Layout from '../layouts/Layout.astro';
import BusinessCard from '../components/BusinessCard.astro';
import '../styles/chat.css';
import { MAX_MESSAGGIO } from '../lib/assistant';
import { directory, brandNames, businessUrl, placeOf } from '../lib/directory';
import { services, businessTypes, specializations, statuses, isUsableCoordinate } from '../lib/schema';
import { REGIONI_ITALIA } from '../lib/geo';
const mapPoints = directory.attivita.filter(b => isUsableCoordinate(b.posizione.coordinate)).map(b => ({ id: b.id, nome: b.nome, comune: placeOf(b).comune, indirizzo: b.posizione.indirizzo ? b.posizione.indirizzo + (b.posizione.cap ? ', ' + b.posizione.cap : '') : null, lat: b.posizione.coordinate!.lat, lon: b.posizione.coordinate!.lon, href: businessUrl(b) }));
// Tutte e 20 le regioni sono selezionabili subito, anche quelle ancora senza schede.
const regioni = Object.values(REGIONI_ITALIA).map(r => [r.slug, r.nome] as const).sort((a, b) => a[1].localeCompare(b[1], 'it'));
// Ogni provincia porta la propria regione: lo script nasconde le province fuori regione.
const province = [...new Map(directory.localita.map(p => [p.provinciaSlug, { label: p.provincia, regione: p.regioneSlug }])).entries()].sort((a, b) => a[1].label.localeCompare(b[1].label, 'it'));
const suggerimenti = ['Cerco cambio batteria a Milano', 'Vorrei una revisione a Roma', 'Vorrei valutare e vendere un orologio'];
---
<Layout title="Trova un orologiaio in Italia" description="Trova un orologiaio per servizio e città. Mappa, risultati documentati e assistente in un solo percorso." noindex>
  <section class="page-hero compact search-hero"><div class="container"><p class="eyebrow">Ricerca orologeria</p><h1>La bottega giusta,<br />in tre passi.</h1><p class="lead">Scegli cosa ti serve, scrivi una città e confronta subito attività e mappa. Se non trovi, chiedi aiuto all’assistente.</p></div></section>
  <section class="container section search-page" data-search-root>
    <form class="search search-flow" id="directory-search" role="search" action="/cerca/">
      <section class="search-step" aria-labelledby="step-service"><div class="step-heading"><span class="step-number">01</span><div><h2 id="step-service">Che cosa ti serve?</h2><p>Scegli un servizio rapido o descrivilo a parole.</p></div></div>
        <div class="quick-services" aria-label="Servizi più richiesti">
          <button type="button" class="quick-service search-shortcut" data-service="revisione" data-shortcut-field="servizio" data-shortcut-value="revisione">Revisione</button><button type="button" class="quick-service search-shortcut" data-service="riparazione" data-shortcut-field="servizio" data-shortcut-value="riparazione">Riparazione</button><button type="button" class="quick-service search-shortcut" data-service="batterie" data-shortcut-field="servizio" data-shortcut-value="batterie">Cambio batteria</button><button type="button" class="quick-service search-shortcut" data-service="cinturini" data-shortcut-field="servizio" data-shortcut-value="cinturini">Cinturino</button><button type="button" class="quick-service search-shortcut" data-service="valutazioni" data-shortcut-field="servizio" data-shortcut-value="valutazioni">Valutazione</button><button type="button" class="quick-service search-shortcut" data-service="acquisto-permuta" data-shortcut-field="servizio" data-shortcut-value="acquisto-permuta">Acquisto / permuta</button><button type="button" class="quick-service search-shortcut" data-shortcut-field="specializzazione" data-shortcut-value="vintage">Orologi vintage e restauro</button><button type="button" class="quick-service search-shortcut" data-shortcut-field="marca" data-shortcut-value="Rolex">Assistenza per marche</button>
        </div>
        <div class="search-fields"><label class="wide">Oppure cerca per servizio, nome o marchio<input type="search" name="q" list="service-suggestions" placeholder="Es. revisione, Rolex, riparazione…" /><datalist id="service-suggestions">{Object.values(services).map(label => <option value={label} />)}</datalist></label><label>Servizio<select name="servizio"><option value="">Tutti i servizi</option>{Object.entries(services).map(([id,label]) => <option value={id}>{label}</option>)}</select></label></div>
      </section>
      <section class="search-step" aria-labelledby="step-region"><div class="step-heading"><span class="step-number">02</span><div><h2 id="step-region">In quale regione cerchi?</h2><p>Scegli la regione: la città è facoltativa.</p></div></div>
        <div class="search-fields"><label>Regione<select name="regione" id="regione-select"><option value="">Tutta Italia</option>{regioni.map(([id,label]) => <option value={id}>{label}</option>)}</select></label></div>
        <label class="city-field">Città o comune (facoltativa)<input type="search" name="comune" list="city-suggestions" placeholder="Es. Milano, Roma, Napoli…" autocomplete="address-level2" /><datalist id="city-suggestions">{directory.localita.map(p => <option value={p.comune} />)}</datalist></label>
        <div id="zone-badge" hidden style="margin-top:12px;background:#e8ede5;border:1px solid #c2cdc0;border-radius:6px;padding:8px 14px;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:0.85rem">
          <span id="zone-info">Zona suggerita dalla connessione (senza GPS)</span>
          <button type="button" id="zone-modify" class="btn btn-ghost" style="padding:4px 10px;min-height:32px;font-size:0.8rem">Modifica zona</button>
        </div>
      </section>
      <details class="advanced-filters"><summary>Affina per territorio, marchio e competenze</summary><div class="search-fields secondary">
        <label>Provincia<select name="provincia" id="provincia-select"><option value="">Tutte</option>{province.map(([id,p]) => <option value={id} data-regione={p.regione}>{p.label}</option>)}</select></label><label>Marchio<select name="marca"><option value="">Tutti</option>{brandNames.map(name => <option>{name}</option>)}</select></label>
        <label>Relazione con il marchio<select name="ruoloMarca"><option value="qualsiasi">Qualsiasi</option><option value="venduti">Vendita documentata</option><option value="riparati">Riparazione documentata</option><option value="esperienza">Esperienza dichiarata</option><option value="assistenzaUfficiale">Assistenza ufficiale documentata</option><option value="rivenditaUfficiale">Rivendita ufficiale documentata</option><option value="menzionati">Menzione storica</option></select></label><label>Tipologia<select name="tipo"><option value="">Tutte</option>{businessTypes.map(t => <option>{t}</option>)}</select></label><label>Specializzazione<select name="specializzazione"><option value="">Tutte</option>{specializations.map(t => <option>{t}</option>)}</select></label><label>Attendibilità<select name="stato"><option value="">Tutti gli stati attivi</option>{Object.entries(statuses).map(([id,label]) => <option value={id}>{label}</option>)}</select></label>
      </div></details>
      <section class="search-step search-submit-step" aria-labelledby="step-results"><div class="step-heading"><span class="step-number">03</span><div><h2 id="step-results">Confronta i professionisti</h2><p>Confronta servizi, marchi e fonti, poi apri la scheda o la mappa.</p></div></div><div class="search-actions"><button class="btn" type="submit">Mostra risultati</button><button class="btn btn-ghost" type="reset">Azzera</button></div></section>
    </form>
    <noscript><p class="notice">I filtri interattivi richiedono JavaScript. Puoi consultare le <a href="/orologerie/">pagine territoriali</a>.</p></noscript>
    <p class="notice coverage-note">Il censimento conta {directory.attivita.length} attività in {directory.localita.length} comuni e non copre ancora tutta Italia. I risultati e i punti in mappa sono mostrati solo quando esistono informazioni documentate e coordinate verificate.</p>
    <section class="valuation-panel" aria-labelledby="valuation-title"><div><p class="eyebrow">Valutazione e acquisto</p><h2 id="valuation-title">Vuoi capire quanto vale il tuo orologio?</h2><p>La directory può aiutarti a contattare attività che dichiarano valutazioni o acquisto e permuta. La stima dipende dall’esame dell’orologio: il sito non inventa un prezzo.</p></div><div class="valuation-actions"><a class="btn" href="/cerca/?servizio=valutazioni">Trova chi valuta</a><a class="text-link" href="/cerca/?servizio=acquisto-permuta">Cerca acquisto e permuta →</a></div></section>
    <section class="assistant-inline" aria-labelledby="assistant-heading"><div class="assistant-intro"><p class="eyebrow dark">Serve una mano?</p><h2 id="assistant-heading">Racconta all’Orologiaio cosa stai cercando.</h2><p>Ti aiuta a interpretare la richiesta e cerca tra le attività presenti. Se la città non è coperta, propone altre località dichiarando che potrebbero essere lontane.</p></div>
      <div class="chat" id="assistente"><div class="chat-top"><div><p class="chat-kicker">Assistente di ricerca</p><h3 class="chat-title">Orologiaio</h3></div><p id="assistente-modalita" class="chat-badge" hidden></p></div>
        <div class="chat-log" id="assistente-chat" role="log" aria-live="polite" aria-relevant="additions text" aria-busy="false"><article class="msg msg-bot"><p class="msg-autore">Orologiaio</p><p>Ciao! Scrivimi servizio e città, per esempio “cambio batteria a Milano”. Cerco nel database e ti dico chiaramente cosa è documentato e dove.</p></article><div class="chat-suggerimenti" id="assistente-suggerimenti"><p class="msg-suggerimenti-intro">Oppure prova:</p><ul class="chips">{suggerimenti.map(s => <li><button type="button" class="chip" data-suggerimento={s}>{s}</button></li>)}</ul></div></div>
        <form id="assistente-form" class="composer" novalidate><label class="sr-only" for="assistente-messaggio">Che cosa ti serve?</label><div class="composer-row"><textarea id="assistente-messaggio" name="messaggio" rows="1" maxlength={MAX_MESSAGGIO} placeholder="Es. cerco una revisione a Roma…" enterkeyhint="send" autocomplete="off" aria-describedby="assistente-contatore assistente-aiuto"></textarea><button type="submit" id="assistente-invia" class="composer-send" aria-label="Invia il messaggio"><svg class="composer-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M3 20.5 21 12 3 3.5 3 10l12 2-12 2z" fill="currentColor" /></svg><span class="composer-label">Cerca</span></button></div><div class="composer-meta"><span id="assistente-contatore" class="contatore">0 / {MAX_MESSAGGIO}</span><span id="assistente-aiuto" class="composer-hint">Invio per inviare · Maiusc + Invio per andare a capo</span></div><p id="assistente-campo-errore" class="composer-errore" hidden></p></form><p id="assistente-stato" class="sr-only" role="status" aria-live="polite"></p>
      </div><p class="chat-note small muted">L’AI interpreta la richiesta solo quando il servizio è configurato. In ogni caso i risultati arrivano dal database e le competenze devono avere fonti. <a href="/orologiaio/">Scopri l’assistente completo →</a></p>
    </section>
    <p id="search-count" class="results-count" role="status" aria-live="polite">{directory.attivita.length} attività nel database</p>
    <div class="discovery-layout"><section class="results-panel" aria-label="Risultati della ricerca"><div class="results-heading"><p class="eyebrow dark">Risultati</p><h2>Attività censite</h2></div><ul class="grid" id="search-results">{directory.attivita.map(b => <BusinessCard business={b} />)}</ul><p id="search-empty" class="notice" hidden>Nessuna attività soddisfa tutti i filtri. Prova ad allargare la località o a rimuovere un requisito: non aggiungiamo risultati con competenze non documentate. Se hai indicato una città nuova, chiedi all’assistente qui sopra di cercare lo stesso servizio altrove.</p></section>
      <aside class="map-panel" aria-label="Mappa delle attività"><div class="map-heading"><div><p class="eyebrow dark">Dove si trovano</p><h2>Mappa</h2></div><span class="map-total">{mapPoints.length} posizioni verificate</span></div><div id="directory-map" data-points={JSON.stringify(mapPoints)}></div><p class="small muted">La mappa mostra solo attività con coordinate verificate e confrontate con l’indirizzo. Le altre restano nei risultati; un punto non certifica una visita sul posto.</p></aside>
    </div>
  </section>
  <script src="../scripts/search-ui.ts"></script><script src="../scripts/map-ui.ts"></script><script src="../scripts/assistant-ui.ts"></script>
  <style>
    .search-hero{background:linear-gradient(115deg,#102f2a,#1b493e 72%,#52644a)}.search-hero h1{max-width:13ch}.search-page{padding-top:42px}.search-flow{display:grid;gap:14px;padding:clamp(18px,3vw,34px);background:#fffefa;border:1px solid #d8ded4;border-radius:18px;box-shadow:0 22px 50px -40px #18342e}.search-step{padding:22px;border:1px solid #e2e4db;border-radius:14px;background:linear-gradient(150deg,#fffefa,#f8f6ef)}.step-heading{display:flex;gap:14px;align-items:flex-start;margin-bottom:18px}.step-number{display:grid;place-items:center;flex:0 0 38px;height:38px;border-radius:50%;background:#173f36;color:#f1d09d;font-size:.76rem;font-weight:750;letter-spacing:.04em}.step-heading h2,.results-heading h2,.map-heading h2{margin:0 0 5px;font-size:clamp(1.35rem,2.5vw,1.8rem)}.step-heading p{margin:0;color:var(--muted);font-size:.9rem}.quick-services{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 17px}.quick-service{min-height:44px;padding:9px 15px;border:1px solid #d4d9cf;border-radius:999px;background:#fffefa;color:#29483e;font-size:.85rem;font-weight:650}.quick-service:hover,.quick-service[aria-pressed="true"]{border-color:#9b713e;background:#f1e8d8;color:#573c1d}.search-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.search-fields label,.city-field{display:grid;gap:7px;font-size:.82rem;font-weight:650}.search-fields .wide{grid-column:1/-1}.search-flow input,.search-flow select{width:100%;min-height:48px;padding:11px 13px;border:1px solid #bdc8bd;border-radius:8px;background:white;color:var(--ink)}.city-field{max-width:760px}.city-field input{font-size:1rem}.advanced-filters{padding:14px 18px;border:1px solid #e2e4db;border-radius:12px;background:#fbfaf6}.advanced-filters summary{color:#315348;font-size:.87rem;font-weight:700}.advanced-filters .secondary{padding-top:16px}.search-submit-step{display:flex;align-items:center;justify-content:space-between;gap:18px;background:#f0f1e8}.search-submit-step .step-heading{margin:0}.search-actions{display:flex;flex-wrap:wrap;gap:9px}.coverage-note{margin:24px 0;padding:15px 18px;border-left:3px solid #a26829;background:#f0eee5;color:#526158;font-size:.84rem}.valuation-panel{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:28px;align-items:center;margin:32px 0;padding:clamp(22px,3vw,34px);border-radius:16px;background:#183f35;color:#fffefa}.valuation-panel .eyebrow{margin-bottom:9px}.valuation-panel h2{max-width:26ch;margin-bottom:10px;font-size:clamp(1.5rem,2.6vw,2.1rem)}.valuation-panel p:not(.eyebrow){max-width:68ch;margin:0;color:#dce5d8;font-size:.9rem}.valuation-actions{display:grid;justify-items:start;gap:12px}.valuation-actions .btn{background:#a26829}.valuation-actions .text-link{color:#f3d5a6}.assistant-inline{margin:30px 0 24px;padding:clamp(20px,3vw,34px);border:1px solid #d9ded4;border-radius:18px;background:linear-gradient(140deg,#f4f1e7,#fffefa)}.assistant-intro{max-width:760px;margin-bottom:18px}.assistant-intro h2{max-width:24ch;margin:0 0 10px;font-size:clamp(1.65rem,3vw,2.35rem)}.assistant-intro p:last-child{max-width:70ch;color:var(--muted)}.assistant-inline .chat{max-width:none}.assistant-inline .chat-log{max-height:360px;min-height:190px}.assistant-inline .chat-results{grid-template-columns:repeat(2,minmax(0,1fr))}.chat-note{margin-bottom:0}.results-count{margin:36px 0 14px;font-size:.88rem;font-weight:700;color:#365347}.discovery-layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:24px;align-items:start}.results-panel,.map-panel{min-width:0;padding:22px;border:1px solid #dce0d7;border-radius:16px;background:#fffefa}.results-heading{margin-bottom:18px}.results-panel .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.results-panel .card{padding:19px}.map-panel{position:sticky;top:20px}.map-heading{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:12px}.map-total{font-size:.7rem;font-weight:650;color:#5e6f64}.map-panel #directory-map{height:min(66vh,620px);min-height:350px;border-radius:11px;overflow:hidden;background:#e8e8dc}.map-panel>p{margin:12px 0 0}.search-page .notice{border-radius:9px}@media(max-width:900px){.discovery-layout{grid-template-columns:1fr}.map-panel{position:static;grid-row:1}.map-panel #directory-map{height:360px;min-height:280px}.valuation-panel{grid-template-columns:1fr}.results-panel .grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.search-page{padding-top:24px}.search-flow{padding:12px;border-radius:13px}.search-step{padding:16px}.search-fields{grid-template-columns:1fr}.search-submit-step{align-items:stretch;flex-direction:column}.search-actions .btn{flex:1}.quick-service{flex:1 1 calc(50% - 8px);text-align:center}.assistant-inline{padding:15px}.assistant-inline .chat-log{min-height:180px;max-height:48vh}.assistant-inline .chat-results{grid-template-columns:1fr}.results-panel,.map-panel{padding:15px}.results-panel .grid{grid-template-columns:1fr}.map-heading{align-items:start;flex-direction:column}.map-panel #directory-map{height:300px}}
  </style>
</Layout>
