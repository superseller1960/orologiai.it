---
import Layout from '../layouts/Layout.astro';
import BusinessCard from '../components/BusinessCard.astro';
import SearchFields from '../components/SearchFields.astro';
import '../styles/search.css';
import '../styles/chat.css';
import '../styles/insights.css';
import { evidenzeAggiornateIl, bilancioEvidenze } from '../lib/evidenze';
const bilancio = bilancioEvidenze();
const dataEvidenze = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${evidenzeAggiornateIl}T12:00:00Z`));
import { MAX_MESSAGGIO } from '../lib/assistant';
import { directory, brandOptions } from '../lib/directory';
import { businessTypes, specializations, statuses } from '../lib/schema';
import { REGIONI_ITALIA } from '../lib/geo';
const regioni = Object.values(REGIONI_ITALIA).sort((a,b) => a.nome.localeCompare(b.nome, 'it'));
const province = [...new Map(directory.localita.map(p => [p.provinciaSlug, { label: p.provincia, regione: p.regioneSlug }])).entries()].sort((a,b) => a[1].label.localeCompare(b[1].label, 'it'));
const suggerimenti = ['Cerco cambio batteria a Milano', 'Vorrei una revisione a Roma', 'Vorrei valutare e vendere un orologio'];
// Fase 41: solo le prime card sono nell'HTML. Le altre le crea search-ui quando servono:
// l'elenco resta completo, ma la pagina non trasporta più 556 schede prima del primo clic.
const PRIME_CARD = 60;
---
<Layout title="Trova un orologiaio in Italia" description="Cerca una città, scegli un servizio facoltativo e confronta le orologerie documentate." noindex>
  <section class="container search-page" data-search-root>
    <p class="eyebrow dark search-intro-kicker">La guida italiana · Esplora le attività</p>
    <h1>Trova il professionista giusto</h1>
    <p class="search-intro-copy">Scegli una città o il servizio che ti serve, confronta le competenze e contatta direttamente l’orologiaio.</p>
    <form class="search search-flow" id="directory-search" role="search" action="/cerca/" method="get">
      <SearchFields />
      <details class="advanced-filters"><summary>Altri filtri <span id="advanced-count"></span></summary><div class="secondary-fields">
        <label>Regione<select name="regione" id="regione-select"><option value="">Tutta Italia</option>{regioni.map(r => <option value={r.slug}>{r.nome}</option>)}</select></label>
        <label>Provincia<select name="provincia" id="provincia-select"><option value="">Tutte</option>{province.map(([id,p]) => <option value={id} data-regione={p.regione}>{p.label}</option>)}</select></label>
        <label>Marchio<select name="marca"><option value="">Tutti</option>{brandOptions.map(name => <option>{name}</option>)}</select></label>
        <label>Relazione con il marchio<select name="ruoloMarca"><option value="qualsiasi">Qualsiasi</option><option value="venduti">Vendita documentata</option><option value="riparati">Riparazione documentata</option><option value="esperienza">Esperienza dichiarata</option><option value="assistenzaUfficiale">Assistenza ufficiale documentata</option><option value="rivenditaUfficiale">Rivendita ufficiale documentata</option><option value="menzionati">Menzione storica</option></select></label>
        <label>Tipologia<select name="tipo"><option value="">Tutte</option>{businessTypes.map(t => <option>{t}</option>)}</select></label>
        <label>Specializzazione<select name="specializzazione"><option value="">Tutte</option>{specializations.map(t => <option>{t}</option>)}</select></label>
        <label>Attendibilità<select name="stato"><option value="">Tutti gli stati attivi</option>{Object.entries(statuses).map(([id,label]) => <option value={id}>{label}</option>)}</select></label>
        <label>Nome, CAP, indirizzo o richiesta libera<input type="search" name="q" placeholder="Es. Sangalli, cambio batteria…" /></label>
        <label class="filter-check"><input type="checkbox" name="soloDocumentate" value="1" /> Solo attività con prova documentata</label>
      </div><p class="small muted">La città selezionata prevale sui filtri geografici. Le autorizzazioni ufficiali sono distinte dalla vendita, riparazione o semplice menzione del marchio.</p></details>
      <div class="search-actions"><button class="btn" type="submit">Mostra risultati</button><button class="btn btn-ghost" type="reset">Azzera</button><button class="btn btn-ghost" type="button" id="atlas-nearby" aria-pressed="false" hidden>Usa la mia posizione</button></div><p class="small muted" id="atlas-nearby-status" role="status" hidden></p>
    </form>
    <noscript><p class="notice">I filtri richiedono JavaScript: l’elenco sotto non è filtrato. Consulta le <a href="/orologerie/">pagine per regione e comune</a> o le <a href="/servizi/riparazione/">pagine per servizio</a>.</p></noscript>
    <div id="active-filters" class="active-filters" aria-label="Filtri attivi"></div>
    <details class="need-path atlas-need-path" aria-labelledby="need-title">
      <summary id="need-title">Non sai quale servizio scegliere? <span>Ti aiutiamo a orientarti</span></summary>
      <p class="need-note">Ogni motivazione è una frase tratta dalla fonte citata nella scheda: {bilancio.confermate} associazioni servizio-attività verificate finora, aggiornate al {dataEvidenze}. Dove la fonte non è recuperabile lo diciamo, invece di dedurre la competenza.</p>
      <p class="small muted">Scegli una richiesta: applichiamo i filtri reali del catalogo. Nessuna attività viene inventata per riempire l’elenco.</p>
      <ul class="need-list">
        <li><button type="button" class="need-item" data-bisogno="riparazione">L’orologio si è fermato</button></li>
        <li><button type="button" class="need-item" data-bisogno="revisione">Perde tempo o va regolato</button></li>
        <li><button type="button" class="need-item" data-bisogno="ricambi">Ho rotto il vetro o la corona</button></li>
        <li><button type="button" class="need-item" data-bisogno="batterie">Devo cambiare la batteria</button></li>
        <li><button type="button" class="need-item" data-bisogno="restauro-vintage">Restaurare un orologio antico</button></li>
        <li><button type="button" class="need-item" data-bisogno="pendoleria">Ho una pendola da riparare</button></li>
        <li><button type="button" class="need-item" data-bisogno="valutazioni">Vorrei vendere un vintage</button></li>
        <li><button type="button" class="need-item" data-bisogno="assistenza-marca">Cerco assistenza per una marca</button></li>
      </ul>
      <p class="small muted need-disclaimer">Scegliere una richiesta applica il filtro del servizio pertinente: è un punto di partenza, non una diagnosi. Se il sintomo è incerto, descrivilo all’assistente più sotto.</p>
    </details>
    <section class="results-panel" aria-labelledby="search-count">
      <h2 id="search-count" tabindex="-1" aria-live="polite">{directory.attivita.length} botteghe e laboratori da esplorare</h2>
      <p id="search-context" class="small muted"></p>
      <div class="atlas-browse"><div class="atlas-map-column"><details class="optional-panel search-map" id="map-details"><summary id="map-summary">Esplora sulla mappa</summary><div class="map-toolbar"><p id="map-status" class="small" role="status" aria-live="polite"></p><button id="map-interact" type="button" class="btn btn-ghost" aria-pressed="false" hidden>Sposta la mappa</button></div><div id="directory-map" role="region" aria-label="Mappa delle attività nei risultati"></div><p class="small muted">Posizioni confrontate con gli indirizzi; le attività senza coordinate restano nell’elenco. <a href="/coordinate-osm.json">Dati geografici · © OpenStreetMap contributors · ODbL</a></p></details></div><div class="atlas-results-column">

      <ul class="grid" id="search-results">{directory.attivita.slice(0, PRIME_CARD).map(b => <BusinessCard business={b} compact editorial />)}</ul>
      <div id="search-empty" class="notice" hidden><p id="search-empty-message">Nessuna attività soddisfa i filtri selezionati.</p><p id="search-alternative" class="small" hidden></p><div class="search-actions"><button type="button" class="btn btn-ghost" id="remove-service" hidden>Rimuovi il servizio</button><button type="button" class="btn btn-ghost" id="search-widen-province" hidden>Amplia alla provincia</button><button type="button" class="btn btn-ghost" id="search-widen" hidden>Cerca in tutta Italia mantenendo gli altri filtri</button><p id="search-province-note" class="small muted" role="status" hidden></p></div><p><a href="/orologerie/">Esplora altre località (fuori dalla ricerca) →</a> · <a href="/orologiaio/">Descrivi la richiesta all’assistente →</a></p><p class="small muted">Nessuna corrispondenza nel catalogo non significa che il servizio non esista sul territorio.</p></div>
      <p id="search-page-count" class="small muted"></p><button type="button" id="search-more" class="btn btn-ghost" hidden>Mostra altri 12</button>
      <section id="search-related" class="related-results" aria-labelledby="search-related-title" hidden><h3 id="search-related-title">Altri laboratori che potrebbero aiutarti</h3><p id="search-related-note" class="small muted"></p><ul class="grid" id="search-related-list"></ul></section>
      </div></div>
    </section>

    <details class="optional-panel guided-search"><summary>Ricerca guidata e assistente (facoltativi)</summary>
      <div class="quick-services" aria-label="Servizi rapidi"><button type="button" class="btn btn-ghost search-shortcut" data-service="revisione" data-shortcut-field="servizio" data-shortcut-value="revisione">Revisione</button><button type="button" class="btn btn-ghost search-shortcut" data-service="riparazione" data-shortcut-field="servizio" data-shortcut-value="riparazione">Riparazione</button><button type="button" class="btn btn-ghost search-shortcut" data-service="batterie" data-shortcut-field="servizio" data-shortcut-value="batterie">Cambio batteria</button></div>
      <p class="small">Scegli un servizio rapido e una città, oppure descrivi il bisogno all’assistente. Le alternative fuori territorio sono dichiarate separatamente.</p>
      <div class="chat" id="assistente"><div class="chat-top"><div><p class="chat-kicker">Assistente di ricerca</p><h3 class="chat-title">Orologiaio</h3></div><p id="assistente-modalita" class="chat-badge" hidden></p></div>
        <div class="chat-log" id="assistente-chat" role="log" aria-live="polite" aria-relevant="additions text" aria-busy="false"><article class="msg msg-bot"><p class="msg-autore">Orologiaio</p><p>Scrivimi servizio e città, per esempio “cambio batteria a Milano”. Cerco nel database e distinguo ciò che è documentato.</p></article><div class="chat-suggerimenti" id="assistente-suggerimenti"><p class="msg-suggerimenti-intro">Oppure prova:</p><ul class="chips">{suggerimenti.map(s => <li><button type="button" class="chip" data-suggerimento={s}>{s}</button></li>)}</ul></div></div>
        <form id="assistente-form" class="composer" novalidate><label class="sr-only" for="assistente-messaggio">Che cosa ti serve?</label><div class="composer-row"><textarea id="assistente-messaggio" name="messaggio" rows="1" maxlength={MAX_MESSAGGIO} placeholder="Es. cerco una revisione a Roma…" enterkeyhint="send" autocomplete="off" aria-describedby="assistente-contatore assistente-aiuto"></textarea><button type="submit" id="assistente-invia" class="composer-send" aria-label="Invia il messaggio"><span class="composer-label">Cerca</span></button></div><div class="composer-meta"><span id="assistente-contatore" class="contatore">0 / {MAX_MESSAGGIO}</span><span id="assistente-aiuto" class="composer-hint">Invio per inviare · Maiusc + Invio per andare a capo</span></div><p id="assistente-campo-errore" class="composer-errore" hidden></p></form><p id="assistente-stato" class="sr-only" role="status" aria-live="polite"></p>
      </div><p class="small muted">L’AI interpreta solo quando configurata; i risultati arrivano dal database. <a href="/orologiaio/">Assistente completo →</a></p>
      <p class="small"><a href="/cerca/?servizio=valutazioni">Valutazioni</a> · <a href="/cerca/?servizio=acquisto-permuta">Acquisto e permuta</a>: la stima richiede l’esame dell’orologio, non viene inventata dal sito.</p>
    </details>
    <details class="optional-panel"><summary>Copertura e metodo</summary><p class="small muted">Il censimento conta {directory.attivita.length} attività in {directory.localita.length} località e non copre ancora tutta Italia. Servizi, marchi e recapiti hanno fonti consultabili nelle schede; non equivalgono a una verifica sul posto. <a href="/metodo/">Fonti e metodo →</a></p></details>
  </section>
  <script src="../scripts/search-ui.ts"></script><script src="../scripts/map-lazy.ts"></script><script src="../scripts/assistant-lazy.ts"></script>
</Layout>

<style is:global>
  /* UX v4: directory browse — retain all search and lazy-map DOM hooks. */
  .search-page .search-intro-kicker{margin:0 0 8px;color:#795a34;letter-spacing:.12em}
  .search-page .search-intro-copy{max-width:65ch;margin:-6px 0 22px;color:#46594f;line-height:1.6}
  .search-page .results-panel #map-details{margin:0 0 20px;border-radius:14px;background:#f8f8f0;border-color:#d1dbcf}
  .search-page .results-panel #map-summary{min-height:44px;display:list-item;padding-block:10px;color:#173e35;font-size:1rem;cursor:pointer}
  .search-page .results-panel #map-details[open] #map-summary{margin-bottom:8px}
  .search-page .results-panel .search-result-card h3{font-size:clamp(1.4rem,2.1vw,1.85rem)!important;overflow-wrap:anywhere;margin-bottom:9px}
  .search-page .results-panel .search-result-card .result-primary{gap:8px}
  .search-page .results-panel .search-result-card .result-secondary{min-width:86px}
  .search-page .results-panel .search-result-card:focus-within{border-color:#688578!important;box-shadow:0 0 0 2px #68857844}
  @media(min-width:980px){
    .search-page .results-panel #search-results,.search-page .results-panel #search-related-list{grid-template-columns:repeat(2,minmax(0,1fr))!important;align-items:stretch;gap:16px!important}
    .search-page .search-result-card .result-main{grid-template-columns:minmax(0,1fr);gap:14px;padding:13px 22px 18px;flex:1}
    .search-page .search-result-card .result-topline{padding:16px 22px 0;align-items:flex-start}
    .search-page .search-result-card .result-types{max-width:48%;overflow-wrap:anywhere}
    .search-page .search-result-card .result-facts{border-left:0;border-top:1px solid #e5e5d8;padding:12px 0 0;gap:8px}
    .search-page .search-result-card .result-primary{padding-inline:22px}
  }
  @media(max-width:680px){
    .search-page .search-intro-copy{font-size:.94rem;margin-bottom:16px}
    .search-page .results-panel .search-result-card .result-main{gap:12px;padding-block:10px 14px}
    .search-page .results-panel .search-result-card .result-facts{padding-top:10px}
    .search-page .results-panel .search-result-card .result-editorial{-webkit-line-clamp:3}
    .search-page .results-panel #search-context{margin-bottom:12px}
    .search-page .results-panel #map-details{margin-bottom:14px}
  }
</style>

<style is:global>
.atlas-v4 .search-page{max-width:1380px}
.atlas-v4 .search-page>h1{font-family:"Atlas Serif",Georgia,serif;font-size:clamp(2.5rem,5vw,4.6rem);letter-spacing:-.045em;max-width:19ch}
.atlas-v4 .search-page .search-flow{background:#fffdf7;border:1px solid #d7d7c9;box-shadow:none;border-radius:6px;padding:24px}
.atlas-v4 .search-page .results-panel{max-width:none}
.atlas-v4 .atlas-browse{display:flex;flex-direction:column;gap:16px}
.atlas-results-column,.atlas-map-column{min-width:0}
.atlas-v4 .search-page .results-panel #map-details{margin:0;background:#fffdf7;border:1px solid #d7d7c9;border-radius:6px}
.atlas-v4 .results-panel .search-result-card{border-radius:6px!important;box-shadow:none}
.atlas-v4 .results-panel .search-result-card .result-primary{background:#172f29}
.atlas-v4 .results-panel .search-result-card .result-secondary{background:#e4eae0}
.atlas-v4 .results-panel .search-result-card .result-place{font-size:.74rem;letter-spacing:.13em}
.atlas-v4 .results-panel .search-result-card .tag{border-radius:4px;background:#e4eae0}
.atlas-v4 .search-page .results-panel #search-count{font-family:"Atlas Serif",Georgia,serif!important}
@media(min-width:1050px){
.atlas-v4 .atlas-browse:has(#map-details[open]){display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.95fr);gap:28px;align-items:start}
.atlas-v4 .atlas-browse:has(#map-details[open]) .atlas-map-column{grid-column:2;grid-row:1;position:sticky;top:18px}
.atlas-v4 .atlas-browse:has(#map-details[open]) .atlas-results-column{grid-column:1;grid-row:1}
.atlas-v4 .atlas-browse:has(#map-details[open]) #search-results,.atlas-v4 .atlas-browse:has(#map-details[open]) #search-related-list{grid-template-columns:minmax(0,1fr)!important}
.atlas-v4 .atlas-browse:has(#map-details[open]) #directory-map{height:clamp(350px,60vh,680px)}
}
@media(max-width:700px){.atlas-v4 .search-page .search-flow{padding:16px}.atlas-v4 .search-page>h1{font-size:2.7rem}}
</style>

<style is:global>
.atlas-v4 .atlas-need-path{padding:0 16px;margin:12px 0 20px;background:#fffdf7;border:1px solid #d7d7c9;border-radius:6px}.atlas-v4 .atlas-need-path summary{padding:14px 0;min-height:48px;font-weight:700;cursor:pointer}.atlas-v4 .atlas-need-path summary span{font-size:.78rem;font-weight:400;color:#53675d;margin-left:8px}.atlas-v4 .atlas-need-path[open]{padding-bottom:16px}.atlas-v4 .atlas-need-path:not([open]){min-height:0}
</style>
