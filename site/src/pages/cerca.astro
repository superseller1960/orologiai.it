---
import Layout from '../layouts/Layout.astro';
import BusinessCard from '../components/BusinessCard.astro';
import { directory, brandNames, businessUrl, placeOf } from '../lib/directory';
import { services, businessTypes, specializations, statuses, isUsableCoordinate } from '../lib/schema';
const mapPoints = directory.attivita.filter(b => isUsableCoordinate(b.posizione.coordinate)).map(b => ({ id: b.id, nome: b.nome, comune: placeOf(b).comune, indirizzo: b.posizione.indirizzo ? `${b.posizione.indirizzo}${b.posizione.cap ? ', ' + b.posizione.cap : ''}` : null, lat: b.posizione.coordinate!.lat, lon: b.posizione.coordinate!.lon, href: businessUrl(b) }));
const regioni = [...new Map(directory.localita.map(p => [p.regioneSlug,p.regione])).entries()];
const province = [...new Map(directory.localita.map(p => [p.provinciaSlug,p.provincia])).entries()];
---
<Layout title="Cerca orologerie e laboratori" description="Cerca nel database per necessità, servizio, località o marchio. Riconoscimento intelligente della richiesta e filtri avanzati per approfondire." noindex>
  <section class="page-hero compact"><div class="container"><p class="eyebrow">La directory, a modo tuo</p><h1>Quali mani stai cercando?</h1><p class="lead">Descrivi ciò che ti serve o scegli una scorciatoia. Puoi cercare in tutta Italia o nella tua zona.</p></div></section>
  <section class="container section" data-search-root>
    <form class="search" id="directory-search" role="search" action="/cerca/">
      <div class="wide" style="margin-bottom:8px">
        <label for="search-q" style="font-size:1.05rem;font-weight:700;margin-bottom:6px">Che cosa ti serve?</label>
        <input id="search-q" type="search" name="q" placeholder="Es. revisione di un Rolex, cambio batteria, riparazione automatico, pendola antica…" style="font-size:1.02rem;padding:14px;border:2px solid #8ba495" />
      </div>

      <div class="wide" id="zone-badge" hidden style="background:#e8ede5;border:1px solid #c2cdc0;border-radius:6px;padding:8px 14px;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:0.85rem">
        <span id="zone-info">Zona suggerita dalla connessione (senza GPS)</span>
        <button type="button" id="zone-modify" class="btn btn-ghost" style="padding:4px 10px;min-height:32px;font-size:0.8rem">Modifica zona</button>
      </div>

      <div class="wide" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:2px">
        <span class="small muted" style="font-weight:600">Scorciatoie frequenti:</span>
        <button type="button" class="btn btn-ghost search-shortcut" data-shortcut-field="servizio" data-shortcut-value="revisione" style="padding:6px 12px;min-height:36px;font-size:0.82rem">Riparazione e revisione</button>
        <button type="button" class="btn btn-ghost search-shortcut" data-shortcut-field="servizio" data-shortcut-value="batterie" style="padding:6px 12px;min-height:36px;font-size:0.82rem">Batteria e cinturino</button>
        <button type="button" class="btn btn-ghost search-shortcut" data-shortcut-field="specializzazione" data-shortcut-value="vintage" style="padding:6px 12px;min-height:36px;font-size:0.82rem">Orologi vintage e restauro</button>
        <button type="button" class="btn btn-ghost search-shortcut" data-shortcut-field="marca" data-shortcut-value="Rolex" style="padding:6px 12px;min-height:36px;font-size:0.82rem">Assistenza per marche</button>
      </div>

      <div class="search-actions wide" style="margin-top:6px">
        <button class="btn" type="submit" style="font-size:1rem;padding:14px 28px">Trova il professionista</button>
        <button class="btn btn-ghost" type="reset">Azzera</button>
      </div>

      <details class="wide" style="margin-top:14px;border-top:1px solid var(--line);padding-top:14px"><summary style="cursor:pointer;font-weight:700">Altri filtri: località, marchi, specializzazioni</summary><div class="search secondary" style="margin-top:14px">
        <label>Comune<select name="localita"><option value="">Tutti i comuni censiti</option>{directory.localita.map(p => <option value={p.id}>{p.comune}</option>)}</select></label>
        <label>Servizio<select name="servizio"><option value="">Tutti i servizi</option>{Object.entries(services).map(([id,label]) => <option value={id}>{label}</option>)}</select></label>
        <label>Regione<select name="regione"><option value="">Tutte le regioni</option>{regioni.map(([id,label]) => <option value={id}>{label}</option>)}</select></label>
        <label>Provincia<select name="provincia"><option value="">Tutte le province</option>{province.map(([id,label]) => <option value={id}>{label}</option>)}</select></label>
        <label>Marchio<select name="marca"><option value="">Tutti i marchi</option>{brandNames.map(name => <option>{name}</option>)}</select></label>
        <label>Relazione con il marchio<select name="ruoloMarca"><option value="qualsiasi">Qualsiasi, incluse menzioni storiche</option><option value="venduti">Vendita documentata</option><option value="riparati">Riparazione documentata</option><option value="esperienza">Esperienza dichiarata</option><option value="assistenzaUfficiale">Assistenza ufficialmente autorizzata</option><option value="rivenditaUfficiale">Rivendita ufficialmente autorizzata</option><option value="menzionati">Solo menzione storica</option></select></label>
        <label>Tipologia<select name="tipo"><option value="">Tutte le tipologie</option>{businessTypes.map(t => <option>{t}</option>)}</select></label>
        <label>Specializzazione<select name="specializzazione"><option value="">Tutte le specializzazioni</option>{specializations.map(t => <option>{t}</option>)}</select></label>
        <label>Attendibilità<select name="stato"><option value="">Tutti gli stati attivi</option>{Object.entries(statuses).map(([id,label]) => <option value={id}>{label}</option>)}</select></label>
      </div></details>
    </form>
    <noscript><p class="notice">JavaScript è disattivato: qui trovi tutte le attività. Per navigare senza filtri usa le <a href="/orologerie/">pagine territoriali</a>. I filtri interattivi richiedono JavaScript.</p></noscript>
    <p class="notice">Ti suggeriamo attività nella tua zona usando una posizione approssimativa della connessione (senza GPS). Puoi modificarla liberamente o cercare in tutta Italia. Censimento iniziale: {directory.attivita.length} attività in {directory.localita.length} località (6 regioni). Solo le posizioni verificate e confrontate con l’indirizzo compaiono sulla mappa ({mapPoints.length} su {directory.attivita.length}).</p>
    <p id="search-count" role="status" aria-live="polite">{directory.attivita.length} attività nel database</p>
    <section aria-label="Mappa delle attività"><div id="directory-map" data-points={JSON.stringify(mapPoints)} style="height:420px;margin-bottom:1.5rem;border-radius:8px"></div><p class="small muted">Mappa: solo le attività con posizione geocodificata e confrontata con l’indirizzo disponibile ({mapPoints.length} su {directory.attivita.length}). Le altre restano nell’elenco; un punto non indica una verifica sul posto.</p></section>
    <ul class="grid" id="search-results">{directory.attivita.map(b => <BusinessCard business={b} />)}</ul>
    <p id="search-empty" class="notice" hidden>Nessuna attività soddisfa tutti i filtri. Prova ad allargare la località o a rimuovere un requisito: non aggiungiamo risultati con competenze non documentate.</p>
  </section>
  <script src="../scripts/search-ui.ts"></script>
  <script src="../scripts/map-ui.ts"></script>
</Layout>
