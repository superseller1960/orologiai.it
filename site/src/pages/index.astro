---
import Layout from '../layouts/Layout.astro';
import SearchFields from '../components/SearchFields.astro';
import '../styles/search.css';
import '../styles/insights.css';
import { directory, localityUrl, businessUrl, brandOptions, brandNames, slugify } from '../lib/directory';
import { brandKey, brandLabel } from '../lib/schema';
import { homePlacements } from '../lib/home-selection';

const editorialBrands = ['IWC','Jaeger-LeCoultre','Baume & Mercier','Vulcain','Panerai'].map(name=>brandNames.find(b=>brandKey(b)===brandKey(name))).filter((name):name is string=>Boolean(name));
const positions = homePlacements();
const featured = positions.filter(p => p.type === 'editorial' && p.display === 'featured');
const selected = positions.filter(p => p.type === 'editorial' && p.display === 'compact');
const sponsored = positions.filter(p => p.type === 'sponsored');
const cities = [...directory.localita]
  .map(p => ({ ...p, count: directory.attivita.filter(b => b.localitaId === p.id).length }))
  .filter(p => p.count > 0)
  .sort((a, b) => b.count - a.count || a.comune.localeCompare(b.comune, 'it'))
  .slice(0, 8);
---

<Layout title="Trova l’orologiaio giusto, in tutta Italia" description="Orologerie, laboratori e botteghe storiche: cerca per regione, località e servizio, consulta le fonti e scopri i professionisti del tempo.">
<div class="atlas-home">
  <section class="atlas-opening" aria-labelledby="atlas-home-title">
    <div class="atlas-opening-art">
      <img src="/images/editorial-movement-ai.webp" width="1130" height="586" alt="Illustrazione editoriale digitale della meccanica di un orologio" fetchpriority="high" />
      <div class="atlas-opening-text"><p class="atlas-eyebrow atlas-light">OROLOGIAI.IT <span></span> GUIDA INDIPENDENTE</p><h1 id="atlas-home-title">Il tempo ha<br/><em>i suoi maestri.</em></h1><p>Scopri i professionisti dell’orologeria italiana, dalle botteghe storiche ai laboratori specializzati.</p><a class="atlas-hero-explore" href="#servizi">Esplora la guida <span aria-hidden="true">↓</span></a></div>
      <small class="atlas-art-credit">Illustrazione editoriale · <a href="/crediti/">Crediti</a></small>
    </div>
    <div class="atlas-find">
      <p class="atlas-eyebrow"><span class="atlas-find-dot"></span> 01 / LA RICERCA</p><h2>Trova il tuo<br/>orologiaio.</h2><p>Riparare, revisionare, acquistare. Comincia da una città.</p>
      <form id="cerca" class="atlas-find-form" action="/cerca/" method="get" role="search">
        <SearchFields prefix="hero" />
        <label class="atlas-brand-field" for="hero-brand">Marchio <small>Facoltativo</small><select id="hero-brand" name="marca"><option value="">Tutti i marchi</option>{brandOptions.map(name=><option value={name}>{name}</option>)}</select></label>
        <button class="atlas-find-submit" type="submit">Trova un orologiaio <span aria-hidden="true">↗</span></button>
      </form>
      <a class="atlas-near-link" href="/cerca/#atlas-nearby"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4"/></svg> Cerca vicino a me <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="atlas-proofbar" aria-label="Dimensione della guida"><div><strong>{directory.attivita.length}</strong><span>attività censite</span></div><div><strong>{directory.localita.length}</strong><span>località</span></div><div><strong>{new Set(directory.localita.map(p=>p.regioneSlug)).size}</strong><span>regioni</span></div><a href="/metodo/">Fonti, trasparenza<br/>e verifica <span aria-hidden="true">↗</span></a></section>

  <section class="atlas-wrap atlas-services" id="servizi">
    <header class="atlas-section-head"><div><p class="atlas-eyebrow">02 / IL TUO PROSSIMO PASSO</p><h2>Di cosa hai bisogno?</h2></div><p>Parti dal tuo orologio. Non serve conoscere il nome dell’intervento.</p></header>
    <div class="atlas-service-grid">
      {[
        {title:'Riparazione',desc:'L’orologio si è fermato o non funziona bene.',href:'/cerca/?servizio=riparazione',icon:'repair'},
        {title:'Revisione',desc:'Manutenzione e cura del movimento.',href:'/cerca/?servizio=revisione',icon:'revision'},
        {title:'Restauro vintage',desc:'Dai nuova vita a un orologio d’epoca.',href:'/cerca/?servizio=restauro-vintage',icon:'vintage'},
        {title:'Acquisto e vendita',desc:'Orologerie, vintage e secondo polso.',href:'/cerca/?servizio=vendita',icon:'trade'},
      ].map((item,i)=><a class="atlas-service-card" href={item.href}><span class="atlas-service-num">0{i+1}</span><svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{item.icon==='repair'?<><path d="M17 63l22-22m-7-7 8 8m-19 14 4 4M40 39c-8-13 2-27 16-24l-9 9 8 8 9-9c3 14-11 24-24 16Z"/><circle cx="22" cy="59" r="4"/></>:item.icon==='revision'?<><circle cx="40" cy="40" r="27"/><circle cx="40" cy="40" r="20"/><path d="M40 18v5m0 34v5M18 40h5m34 0h5M40 40V26m0 14 11 9"/><circle cx="40" cy="40" r="3"/></>:item.icon==='vintage'?<><path d="M32 16h16l3 12m-22 0 3-12m0 48h16l3-12m-22 0 3 12"/><circle cx="40" cy="40" r="20"/><circle cx="40" cy="40" r="15"/><path d="M40 40l-6-8m6 8 9-3m12 0h4v7h-4"/></>:<><path d="M14 28h48l-9-9m9 9-9 9M66 52H18l9-9m-9 9 9 9"/><circle cx="40" cy="40" r="13"/><path d="M40 40v-7m0 7 5 3"/></>}</svg><h3>{item.title}</h3><p>{item.desc}</p><span class="atlas-card-arrow" aria-hidden="true">↗</span></a>)}
    </div>
    <div class="atlas-help-strip"><span>Non sai quale intervento ti serve?</span><a href="/orologiaio/">Chiedi all’Orologiaio <span aria-hidden="true">→</span></a><a href="/cerca/?servizio=batterie">Cambio batteria →</a></div>
  </section>

  <section id="marchi" class="atlas-wrap edition-brands"><header class="atlas-section-head"><div><p class="atlas-eyebrow">03 / CULTURA OROLOGIERA</p><h2>Il mondo delle maison.</h2></div><p>Conosci i marchi e scopri le competenze documentate dei professionisti italiani.</p></header><div class="edition-brands-list">{editorialBrands.map(name=><a href={`/marchi/${slugify(name)}/`}><strong>{brandLabel(name)}</strong><small>Scopri il marchio ↗</small></a>)}</div></section>
  <section class="atlas-territories">
    <div class="atlas-wrap atlas-territory-layout">
      <div class="atlas-territory-intro"><p class="atlas-eyebrow atlas-light">04 / L’ATLANTE ITALIANO</p><h2>Ogni città.<br/><em>Una storia.</em></h2><p>Esplora le attività per comune e regione, oppure scegli una delle località più presenti nella guida.</p><a class="atlas-outline" href="/orologerie/">Esplora tutti i territori <span aria-hidden="true">↗</span></a><div class="atlas-territory-dial" aria-hidden="true"></div></div>
      <div class="atlas-city-grid">{cities.map((city,i)=><a href={localityUrl(city)}><span class="atlas-city-index">0{i+1} / {city.siglaProvincia}</span><strong>{city.comune}</strong><small>{city.count} attività</small><span class="atlas-card-arrow" aria-hidden="true">↗</span></a>)}</div>
    </div>
  </section>

  <section class="atlas-wrap atlas-stories" id="botteghe">
    <header class="atlas-section-head"><div><p class="atlas-eyebrow">05 / SELEZIONE EDITORIALE</p><h2>Le botteghe da conoscere.</h2></div><p>Tre storie, tre città. Una selezione indipendente, non una classifica.</p></header>
    <div class="atlas-story-grid">{featured.map((p,i)=><article class:list={['atlas-story',{'atlas-story-main':i===0}]}><a class="atlas-story-link" href={businessUrl(p.business)}>{p.image?<figure class="atlas-story-photo"><img src={p.image.src} alt={p.image.alt} loading="lazy"/><figcaption>{p.image.credit} · {p.image.license}</figcaption></figure>:<div class="atlas-story-art" aria-hidden="true"><span>RITRATTO / 0{i+1}</span><span class="atlas-story-dial"></span><strong>{p.business.storia.annoFondazione||p.place.siglaProvincia}</strong><small>{p.place.comune}</small></div>}<div class="atlas-story-copy"><p class="atlas-eyebrow">{p.place.comune}{p.business.storia.annoFondazione && <> · dal {p.business.storia.annoFondazione}</>}</p><h3>{p.business.nome}</h3><p>{p.text}</p><span class="atlas-story-cta">Scopri la bottega ↗</span></div></a></article>)}</div>
    <div class="atlas-more-stories" id="altre-botteghe"><div><p class="atlas-eyebrow">ALTRI INDIRIZZI</p><h3>Altre storie, altri luoghi.</h3><p>Da nord a sud, altre botteghe da scoprire.</p></div><div>{selected.map(p=><a href={businessUrl(p.business)}><span><small>{p.place.comune}{p.business.storia.annoFondazione && <> · dal {p.business.storia.annoFondazione}</>}</small><strong>{p.business.nome}</strong><span class="atlas-row-description">{p.text}</span></span><span aria-hidden="true">↗</span></a>)}</div></div><p class="atlas-selection-note">Scelte per storia documentata e distribuzione geografica. <a href="/metodo/">Il nostro metodo</a></p>
  </section>
  {sponsored.length>0 && <section class="atlas-wrap atlas-sponsored" aria-labelledby="sponsored-title"><p class="atlas-eyebrow">PUBBLICITÀ</p><h2 id="sponsored-title">Contenuti sponsorizzati</h2>{sponsored.map(p=><article><p>Contenuto sponsorizzato · {p.place.comune}</p><h3><a href={businessUrl(p.business)}>{p.business.nome}</a></h3><p>{p.text}</p>{p.image && <figure><img src={p.image.src} alt={p.image.alt} loading="lazy"/><figcaption>{p.image.credit}</figcaption></figure>}</article>)}</section>}

  <section class="atlas-journal"><div class="atlas-wrap atlas-journal-layout"><figure><img src="/images/strumento-spirale.jpg" width="960" height="1440" alt="Strumento storico per la regolazione della spirale di un orologio" loading="lazy"/><figcaption><a href="/crediti/">Crediti immagine</a></figcaption></figure><div><p class="atlas-eyebrow">06 / STORIE E GUIDE</p><h2>Il sapere<br/><em>delle mani.</em></h2><p>Una spirale sottile, un gesto preciso, il battito di un movimento. Dietro ogni orologio meccanico c’è un sapere fatto di pazienza e strumenti speciali.</p><a class="atlas-solid" href="/blog/">Leggi il magazine ↗</a></div></div></section>
  <section class="atlas-wrap atlas-final"><div><p class="atlas-eyebrow">RICERCA GUIDATA</p><h2>Una domanda sul tuo orologio?</h2><p>Descrivi quello che cerchi, senza dover conoscere i termini tecnici.</p><a href="/orologiaio/">Chiedi all’Orologiaio ↗</a></div><div><p class="atlas-eyebrow">PER LE ATTIVITÀ</p><h2>Il tuo mestiere merita di essere conosciuto.</h2><p>Scopri come raccontare il tuo laboratorio nella guida.</p><a href="/partecipa/#profilo-professionale">Scopri il progetto ↗</a></div></section>
</div>
</Layout>
<style is:global>
.atlas-home{--ah-ink:#172f29;--ah-cream:#f7f3e9;--ah-white:#fffdf8;--ah-gold:#a27b49;--ah-rule:#d7d3c5;--ah-muted:#52645b;background:var(--ah-cream);color:var(--ah-ink)}
.atlas-home *{box-sizing:border-box}.atlas-home a{color:inherit}.atlas-home h1,.atlas-home h2,.atlas-home h3{font-family:"Atlas Serif",Georgia,serif;font-weight:400;letter-spacing:-.045em;line-height:1.08;margin:0}.atlas-home p{line-height:1.6}.atlas-wrap{width:min(1360px,calc(100% - 96px));margin-inline:auto}.atlas-eyebrow{font:750 .67rem/1.45 system-ui,sans-serif!important;letter-spacing:.17em;text-transform:uppercase;color:#805b2e;margin:0 0 15px}.atlas-light{color:#dfc79a}.atlas-opening{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(350px,.65fr);min-height:590px;max-width:1800px;margin:0 auto}.atlas-opening-art{position:relative;isolation:isolate;min-height:590px;background:#142f28;color:#fffdf8;display:flex;align-items:flex-end;overflow:hidden}.atlas-opening-art>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:58% center;z-index:-2}.atlas-opening-art:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#0a1e1ae8 0%,#0a1e1a9c 45%,#0a1e1a20 100%),linear-gradient(0deg,#071b16cf,transparent 65%);z-index:-1}.atlas-opening-text{padding:64px clamp(30px,4.6vw,76px) 64px;max-width:720px}.atlas-opening-text h1{font-size:clamp(3.3rem,5.85vw,6.5rem);color:#fffdf8;line-height:1.02;letter-spacing:-.07em}.atlas-opening-text h1 em{color:#e4c99a;font-weight:400}.atlas-opening-text>p:last-child{font-size:clamp(1rem,1.6vw,1.2rem);color:#f1ede4;max-width:42ch;margin:24px 0 0}.atlas-opening-text .atlas-eyebrow span{display:inline-block;width:20px;border-top:1px solid #d4b77f;vertical-align:middle;margin-inline:7px}.atlas-art-credit{position:absolute;bottom:15px;right:18px;color:#f3e8d2;font-size:.65rem}
.atlas-find{background:#fffdf8;padding:clamp(30px,4vw,65px) clamp(24px,3.5vw,56px);align-self:stretch;display:flex;flex-direction:column;justify-content:center;min-width:0}.atlas-find h2{font-size:clamp(2.4rem,3.5vw,4rem)}.atlas-find>p:not(.atlas-eyebrow){font-size:.94rem;color:var(--ah-muted);margin:12px 0 22px}.atlas-find-form{display:flex;flex-direction:column;gap:13px;min-width:0}.atlas-find-form .primary-search-fields{display:flex;flex-direction:column;gap:13px;min-width:0}.atlas-find-form label{display:block;font:700 .8rem/1.5 system-ui,sans-serif;color:var(--ah-ink);margin:0}.atlas-find-form label .optional,.atlas-brand-field small{font-weight:400;color:#52645b;margin-left:5px}.atlas-find-form input,.atlas-find-form select{width:100%;min-height:47px;border:1px solid #b7bfb3;border-radius:3px;background:#fffdf8;padding:10px 12px;color:#172f29;font:400 .92rem/1.35 system-ui,sans-serif;margin-top:5px}.atlas-find-form .locality-picker{position:relative}.atlas-find-form .locality-suggestions{z-index:20;top:100%;max-height:220px;overflow:auto;background:#fffdf8}.atlas-find-form .locality-hint{font-size:.72rem;color:var(--ah-muted);margin:5px 0 0}.atlas-find-form .service-hint{display:none}.atlas-find-submit,.atlas-solid{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#172f29;color:#fffdf8!important;min-height:52px;padding:13px 17px;border:0;border-radius:3px;font-weight:750;text-decoration:none}.atlas-find-submit:hover,.atlas-solid:hover{background:#31584a}.atlas-near-link{display:flex;align-items:center;gap:9px;margin-top:19px;font-size:.85rem;font-weight:700;text-decoration:none;color:#805b2e!important}.atlas-near-link span{margin-left:auto}
.atlas-proofbar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));width:min(1360px,calc(100% - 96px));margin:auto;padding:24px 0;border-bottom:1px solid var(--ah-rule);align-items:center}.atlas-proofbar>div{display:flex;align-items:baseline;gap:10px;border-right:1px solid var(--ah-rule);padding-inline:22px}.atlas-proofbar>div:first-child{padding-left:0}.atlas-proofbar strong{font:400 clamp(1.9rem,3.6vw,3.7rem)/1 Georgia,serif;letter-spacing:-.07em}.atlas-proofbar span{font-size:.8rem;color:var(--ah-muted)}.atlas-proofbar>a{display:flex;gap:12px;justify-content:space-between;align-items:center;padding-left:24px;text-decoration:none;font-size:.82rem;font-weight:700}
.atlas-services,.atlas-stories{padding-block:clamp(48px,6vw,82px)}.atlas-section-head{display:flex;justify-content:space-between;gap:32px;align-items:end;margin-bottom:26px}.atlas-section-head h2{font-size:clamp(2.1rem,4vw,4rem)}.atlas-section-head>p{color:var(--ah-muted);font-size:.95rem;max-width:32ch;margin:0}.atlas-service-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.atlas-service-card{position:relative;min-height:240px;display:flex;flex-direction:column;background:var(--ah-white);border:1px solid var(--ah-rule);padding:20px;text-decoration:none;transition:transform .2s,border-color .2s;min-width:0}.atlas-service-card:hover{transform:translateY(-3px);border-color:#9d845d}.atlas-service-card svg{width:76px;height:76px;color:#86673b;align-self:center;margin:5px 0 18px}.atlas-service-num,.atlas-city-index{font:700 .67rem/1.4 system-ui,sans-serif;letter-spacing:.12em;color:#805b2e}.atlas-service-card h3{font-size:clamp(1.35rem,2vw,1.9rem);margin:0 25px 9px 0}.atlas-service-card p{font-size:.84rem;color:var(--ah-muted);margin:0;max-width:26ch}.atlas-card-arrow{position:absolute;right:16px;top:17px;font-size:1.25rem;font-weight:500}.atlas-help-strip{display:flex;gap:18px;align-items:center;flex-wrap:wrap;padding:19px 0 0;font-size:.86rem}.atlas-help-strip>span{color:var(--ah-muted)}.atlas-help-strip a{font-weight:700;text-decoration:underline;text-underline-offset:3px}
.atlas-territories{background:#172f29;color:#fffdf8;padding-block:clamp(38px,5vw,66px)}.atlas-territory-layout{display:grid;grid-template-columns:minmax(0,.74fr) minmax(0,1.26fr);gap:clamp(25px,5vw,75px);align-items:stretch}.atlas-territory-intro{position:relative;isolation:isolate;overflow:hidden;min-width:0;display:flex;flex-direction:column;justify-content:center}.atlas-territory-intro h2{font-size:clamp(2.7rem,4.8vw,5rem);color:#fffdf8}.atlas-territory-intro h2 em{color:#dfc79a}.atlas-territory-intro>p:not(.atlas-eyebrow){color:#e2e7dc;max-width:34ch;font-size:.95rem}.atlas-outline{display:inline-flex;gap:20px;align-items:center;border:1px solid #c5ab7c;padding:12px 16px;margin-top:12px;color:#e8d3a9!important;text-decoration:none;font-weight:700;font-size:.83rem;align-self:start;min-height:44px}.atlas-territory-dial{position:absolute;z-index:-1;right:-30%;bottom:-50%;width:100%;aspect-ratio:1;border:1px solid #c5ab7c45;border-radius:50%;box-shadow:0 0 0 24px #c5ab7c0a,0 0 0 25px #c5ab7c35,0 0 0 56px #c5ab7c0a,0 0 0 57px #c5ab7c25}.atlas-city-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:#617267}.atlas-city-grid>a{display:flex;flex-direction:column;min-height:110px;background:#213d33;position:relative;padding:18px 20px;text-decoration:none;gap:7px;min-width:0}.atlas-city-grid>a:hover{background:#345448}.atlas-city-grid .atlas-city-index{color:#d3b982}.atlas-city-grid strong{font:400 clamp(1.2rem,2.4vw,2rem)/1.05 Georgia,serif;color:#fffdf8;overflow-wrap:anywhere}.atlas-city-grid small{font-size:.76rem;color:#dbe1d6}.atlas-city-grid .atlas-card-arrow{color:#d4b77f}
.atlas-story-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);grid-template-rows:1fr 1fr;gap:14px}.atlas-story{min-width:0;background:var(--ah-white);border:1px solid var(--ah-rule);overflow:hidden}.atlas-story-main{grid-row:span 2}.atlas-story-link{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr);height:100%;text-decoration:none}.atlas-story-main .atlas-story-link{display:flex;flex-direction:column}.atlas-story-art{min-height:205px;position:relative;isolation:isolate;background:#263d33;overflow:hidden;color:#e7d0a5;padding:18px;display:flex;flex-direction:column;justify-content:space-between}.atlas-story-main .atlas-story-art{min-height:320px}.atlas-story:nth-child(2) .atlas-story-art{background:#c5b69d;color:#3e493c}.atlas-story:nth-child(3) .atlas-story-art{background:#42594b;color:#f0dbb4}.atlas-story-art>span:first-child,.atlas-story-art small{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase}.atlas-story-art strong{font:400 clamp(2.3rem,5vw,6.5rem)/1 Georgia,serif;letter-spacing:-.09em;align-self:center}.atlas-story-dial{position:absolute;width:78%;aspect-ratio:1;border-radius:50%;border:1px solid currentColor;opacity:.25;z-index:-1;top:17%;right:-25%;box-shadow:0 0 0 13px #ffffff0a,0 0 0 14px currentColor,0 0 0 31px #ffffff08,0 0 0 32px currentColor}.atlas-story-photo{margin:0}.atlas-story-photo img{display:block;width:100%;height:100%;max-height:340px;object-fit:cover}.atlas-story-photo figcaption{font-size:.7rem;padding:5px;overflow-wrap:anywhere}.atlas-story-copy{display:flex;flex-direction:column;align-items:flex-start;padding:22px;min-width:0}.atlas-story-copy h3{font-size:clamp(1.4rem,2.5vw,2.7rem);overflow-wrap:anywhere}.atlas-story-copy>p:not(.atlas-eyebrow){font-size:.88rem;color:var(--ah-muted);margin:12px 0}.atlas-story-cta{font-size:.81rem;font-weight:700;border-bottom:1px solid #a98a62;padding:8px 0;margin-top:auto}.atlas-more-stories{display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1.35fr);gap:40px;margin-top:38px;border-top:1px solid var(--ah-rule);padding-top:28px}.atlas-more-stories h3{font-size:clamp(1.8rem,3vw,3rem)}.atlas-more-stories p{color:var(--ah-muted);font-size:.9rem}.atlas-more-stories>div:nth-child(2)>a{display:flex;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid var(--ah-rule);text-decoration:none}.atlas-more-stories a small,.atlas-row-description{display:block;color:var(--ah-muted);font-size:.75rem}.atlas-more-stories a strong{font-size:1rem}.atlas-selection-note{font-size:.77rem;color:var(--ah-muted);margin-top:22px}
