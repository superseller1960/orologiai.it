---
import Layout from '../layouts/Layout.astro';
import { directory } from '../lib/directory';
import { MAX_MESSAGGIO } from '../lib/assistant';
const localita = directory.localita.map(p => ({ id: p.id, label: `${p.comune} (${p.siglaProvincia})` })).sort((a, b) => a.label.localeCompare(b.label, 'it'));
const esempi = [
  'Cerco un orologiaio a Firenze che possa revisionare un orologio automatico',
  'Vorrei trovare un laboratorio esperto in Omega, anche se non è un centro ufficiale',
  'Cerco un centro assistenza ufficiale Rolex vicino a Milano',
  'Mi si è fermato l’orologio: vorrei trovare un professionista vicino a me',
  'Cerco un orologiaio che restauri orologi da tasca antichi',
  'Vorrei sostituire il cinturino di un orologio',
  'Cerco un negozio che acquisti orologi usati',
  'Vorrei trovare un’orologeria aperta oggi a Firenze',
];
---
<Layout title="Chiedi all’Orologiaio" description="Descrivi che cosa ti serve: l’Orologiaio consulta il database delle orologerie, mostra le fonti e distingue servizi e autorizzazioni ufficiali." noindex={false}>
  <section class="page-hero compact"><div class="container"><p class="eyebrow">Orologiaio</p><h1>Descrivi il problema,<br />troviamo la bottega giusta.</h1><p class="lead">Scrivi in linguaggio naturale. L’Orologiaio cerca nel database reale e spiega perché ogni attività compare. Dove un’informazione manca, lo dice.</p></div></section>
  <section class="container section">
    <form id="assistente-form" class="search" role="search" aria-describedby="assistente-note">
      <label class="wide">La tua richiesta<textarea name="messaggio" rows="3" maxlength={MAX_MESSAGGIO} placeholder="Es. Cerco un orologiaio a Firenze per revisionare un automatico" required></textarea></label>
      <p id="assistente-contatore" class="small muted wide" aria-live="polite">0 / {MAX_MESSAGGIO} caratteri</p>
      <label>Località (facoltativa)<select name="localita"><option value="">Nessuna preferenza</option>{localita.map(p => <option value={p.id}>{p.label}</option>)}</select></label>
      <div class="search-actions"><button class="btn" type="submit">Cerca con l’Orologiaio</button><button class="btn btn-ghost" type="button" id="assistente-posizione">Usa la mia posizione</button><button class="btn btn-ghost" type="reset">Azzera</button></div>
      <p id="assistente-note" class="small muted wide">La posizione è facoltativa: viene usata solo per questa ricerca, non viene salvata né inviata a servizi esterni. Puoi anche indicare una città nel testo o nel campo località. <a href="/cerca/">Preferisci i filtri classici? Usa la ricerca del database →</a></p>
    </form>
    <div class="search-examples wide">
      <p class="small muted">Esempi di richieste:</p>
      <ul class="tags">{esempi.map(e => <li><button class="tag" type="button" data-esempio={e}>{e}</button></li>)}</ul>
    </div>
    <p id="assistente-stato" role="status" aria-live="polite" aria-busy="false"></p>
    <div id="assistente-spiegazione" class="notice" hidden></div>
    <div id="assistente-messaggi" class="notice" hidden></div>
    <ul class="grid" id="assistente-risultati"></ul>
    <h2 id="assistente-alternative-titolo" hidden>Alternative da verificare (non autorizzate)</h2>
    <ul class="grid" id="assistente-alternative"></ul>
    <p class="small muted">Assistente in modalità locale: interpreta le richieste con regole verificabili sul database. Un servizio di interpretazione esterno non è collegato in questo sito e non è attivo. Gli orari sono mostrati solo se indicati dalla fonte; nessuna disponibilità immediata viene dedotta.</p>
  </section>
  <script src="../scripts/assistant-ui.ts"></script>
</Layout>
