---
import { directory } from '../lib/directory';
import { macroAreeServizi, services } from '../lib/schema';
interface Props { prefix?: string; }
const { prefix = 'search' } = Astro.props;
const attive = directory.attivita.filter(b => b.attendibilita.stato !== 'chiusa');
const conteggi = new Map<string, number>();
for (const b of attive) for (const s of b.servizi) conteggi.set(s.id, (conteggi.get(s.id) ?? 0) + 1);
const gruppi = macroAreeServizi
  .map(area => ({ titolo: area.titolo, servizi: area.servizi.filter(id => (conteggi.get(id) ?? 0) > 0) }))
  .filter(area => area.servizi.length > 0);
---
<div class="primary-search-fields">
  <div class="locality-picker" data-locality-picker data-places={JSON.stringify(directory.localita.map(({ id, comune, provincia, regione }) => ({ id, comune, provincia, regione })))}>
    <label for={`${prefix}-city`}>Dove cerchi?</label>
    <input id={`${prefix}-city`} name="comune" type="search" placeholder="Città o comune, es. Firenze" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${prefix}-suggestions`} aria-describedby={`${prefix}-hint`} enterkeyhint="search" />
    <ul id={`${prefix}-suggestions`} class="locality-suggestions" role="listbox" hidden></ul>
    <p id={`${prefix}-hint`} class="locality-hint" role="status" aria-live="polite">Lascia vuoto per cercare in tutta Italia.</p>
  </div>
  <label for={`${prefix}-service`}>Che servizio cerchi? <span class="optional">Facoltativo</span><select id={`${prefix}-service`} name="servizio" aria-describedby={`${prefix}-service-hint`}><option value="">Qualsiasi servizio</option>{gruppi.map(area => <optgroup label={area.titolo}>{area.servizi.map(id => <option value={id} data-label={services[id]}>{services[id]} ({conteggi.get(id)})</option>)}</optgroup>)}</select></label>
</div>
<p id={`${prefix}-service-hint`} class="locality-hint service-hint">Quattro percorsi, con le specializzazioni documentate. Il numero indica le attività disponibili; si aggiorna quando scegli una località.</p>
<script src="../scripts/locality-ui.ts"></script>
