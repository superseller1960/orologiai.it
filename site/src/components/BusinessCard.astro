---
import type { Business } from '../lib/schema';
import { services, statuses } from '../lib/schema';
import { businessUrl, placeOf } from '../lib/directory';
interface Props { business: Business; }
const { business: b } = Astro.props;
const place = placeOf(b);
---
<li class="card" data-business-id={b.id}>
  <div class="card-top"><span class="eyebrow dark">{place.comune} · {place.siglaProvincia}</span><span class="status">{statuses[b.attendibilita.stato]}</span></div>
  <h3><a href={businessUrl(b)}>{b.nome}</a></h3>
  <p class="meta">{b.storia.annoFondazione ? `Storia documentata dal ${b.storia.annoFondazione}` : 'Una bottega da conoscere'}</p>
  <p>{b.descrizione}</p>
  <p class="small muted">{b.posizione.indirizzo ?? 'Indirizzo non ancora verificato'}</p>
  <div class="tags">{b.servizi.map(s => <span class="tag">{services[s.id]}</span>)}</div>
  <p class="distance small" hidden></p>
  <a class="text-link" href={businessUrl(b)}>Esplora la scheda <span aria-hidden="true">↗</span></a>
</li>
