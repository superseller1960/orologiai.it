---
import type { Business } from '../lib/schema';
import { services, statuses } from '../lib/schema';
import { businessUrl, placeOf } from '../lib/directory';
interface Props { business: Business; compact?: boolean; }
const { business: b, compact = false } = Astro.props;
const place = placeOf(b);
---
<li class="card" data-business-id={b.id}>
  <div class="card-top"><span class="eyebrow dark">{place.comune} · {place.siglaProvincia}</span><span class="status">{statuses[b.attendibilita.stato]}</span></div>
  <h3><a href={businessUrl(b)}>{b.nome}</a></h3>
  {!compact && <><p class="meta">{b.storia.annoFondazione ? `Storia documentata dal ${b.storia.annoFondazione}` : 'Una bottega da conoscere'}</p>
  <p>{b.descrizione}</p>
  </>}
  {compact && <p class="meta result-types">{b.tipi.join(' · ')}</p>}
  <p class="small muted">{b.posizione.indirizzo ?? 'Indirizzo non ancora verificato'}</p>
  <div class="tags">{(compact ? b.servizi.slice(0,3) : b.servizi).map(s => <span class="tag">{services[s.id]}</span>)}</div>
  <p class="distance small" hidden></p>
  {compact && (b.marchi.assistenzaUfficiale.length > 0 || b.marchi.rivenditaUfficiale.length > 0) && <p class="small muted">{b.marchi.assistenzaUfficiale.map(m => `Assistenza ufficiale ${m.marca}`).concat(b.marchi.rivenditaUfficiale.map(m => `Rivendita ufficiale ${m.marca}`)).join(' · ')}</p>}
  {compact ? <div class="result-actions">{b.contatti.telefono && <a href={`tel:${b.contatti.telefono.replace(/[^+\d]/g, '')}`} class="small">Chiama</a>}<a class="text-link" href={businessUrl(b)}>Esplora la scheda <span aria-hidden="true">↗</span></a></div> : <a class="text-link" href={businessUrl(b)}>Esplora la scheda <span aria-hidden="true">↗</span></a>}
</li>
