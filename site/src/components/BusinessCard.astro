---
import type { Business } from '../lib/schema';
import { services, statuses } from '../lib/schema';
import { businessUrl, placeOf } from '../lib/directory';
interface Props { business: Business; }
const { business: b } = Astro.props;
const place = placeOf(b);
const telHref = b.contatti.telefono ? `tel:${b.contatti.telefono.replace(/[^+\d]/g, '')}` : null;
const allBrands = [...new Set([
  ...b.marchi.assistenzaUfficiale.map(m => m.marca),
  ...b.marchi.rivenditaUfficiale.map(m => m.marca),
  ...b.marchi.riparati.map(m => m.marca),
  ...b.marchi.esperienza.map(m => m.marca),
  ...b.marchi.venduti.map(m => m.marca),
])];
const shortDesc = b.descrizione.length > 145 ? `${b.descrizione.slice(0, 142).trim()}…` : b.descrizione;
---
<li class="card" data-business-id={b.id}>
  <div class="card-top">
    <span class="eyebrow dark">{place.comune} ({place.siglaProvincia}) · {b.tipi.join(' / ')}</span>
    <span class="status">{statuses[b.attendibilita.stato]}</span>
  </div>
  <h3><a href={businessUrl(b)}>{b.nome}</a></h3>
  <p class="card-address small muted">
    {b.posizione.indirizzo ? `${b.posizione.indirizzo}${b.posizione.cap ? `, ${b.posizione.cap}` : ''} — ${place.comune}` : `${place.comune} (${place.siglaProvincia}) · indirizzo civico da verificare`}
    {b.storia.annoFondazione ? ` · Dal ${b.storia.annoFondazione}` : ''}
  </p>
  <p class="card-desc">{shortDesc}</p>
  {b.servizi.length > 0 && (
    <div class="tags" aria-label="Servizi documentati">
      {b.servizi.slice(0, 5).map(s => <span class="tag">{services[s.id]}</span>)}
      {b.servizi.length > 5 && <span class="tag tag-more">+{b.servizi.length - 5} altri</span>}
    </div>
  )}
  {allBrands.length > 0 && (
    <p class="card-brands small muted">
      <strong>Marchi documentati:</strong> {allBrands.slice(0, 4).join(', ')}{allBrands.length > 4 ? ` (+${allBrands.length - 4})` : ''}
    </p>
  )}
  <p class="distance small" hidden></p>
  <div class="card-footer">
    <div class="card-quick-contacts">
      {telHref && <a class="card-action-link" href={telHref} aria-label={`Chiama ${b.nome} al ${b.contatti.telefono}`}>Tel. {b.contatti.telefono}</a>}
      {b.contatti.sito && <a class="card-action-link" href={b.contatti.sito} rel="noreferrer">Sito ufficiale ↗</a>}
    </div>
    <a class="text-link card-main-link" href={businessUrl(b)}>Scheda e fonti <span aria-hidden="true">→</span></a>
  </div>
</li>
