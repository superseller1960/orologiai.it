---
import '../styles/directory.css';
interface Props { title: string; description: string; canonical?: string; noindex?: boolean; schema?: Record<string, unknown>; }
const { title, description, canonical = Astro.url.pathname, noindex = false, schema } = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site).href;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#792e32" />
    <link rel="stylesheet" href="/edition-06.css" />
    <title>{title} | Orologiai.it</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {Astro.url.pathname === '/' && <link rel="stylesheet" href="/home-upgrade.css" />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  </head>
  <body class="atlas-v4 atlas-edition">
    <a class="skip" href="#contenuto">Salta al contenuto</a>
    <header class="site-header"><div class="container bar">
      <a class="brand" href="/" aria-label="Orologiai.it, homepage"><svg class="atlas-brand-dial" width="38" height="38" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18.5" fill="none" stroke="currentColor" stroke-width="1"/><path d="M20 4v4M20 32v4M4 20h4M32 20h4M20 20l-8-7m8 7 10-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="20" cy="20" r="1.8" fill="currentColor"/></svg><span class="atlas-wordmark">OROLOGIAI<span>.it</span><small>L’ATLANTE ITALIANO DEL TEMPO</small></span></a>
      <nav class="desktop-nav" aria-label="Navigazione principale">
        <a href="/cerca/">Trova un orologiaio</a><a href="/orologiaio/">Chiedi all’Orologiaio</a><a href="/orologerie/">Territori</a><a href="/marchi/">Marchi</a><button class="atlas-favorites-menu" type="button" data-atlas-favorites aria-haspopup="dialog" hidden>Preferiti</button><a href="/blog/">Storie e guide</a><a class="nav-cta" href="/partecipa/#profilo-professionale">Per le attività</a>
      </nav>
      <details class="mobile-nav"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Navigazione mobile"><a href="/cerca/">Trova un orologiaio</a><a href="/orologiaio/">Chiedi all’Orologiaio</a><a href="/orologerie/">Territori</a><a href="/marchi/">Marchi</a><button class="atlas-favorites-menu" type="button" data-atlas-favorites aria-haspopup="dialog" hidden>Preferiti</button><a href="/blog/">Storie e guide</a><a href="/partecipa/#profilo-professionale">Per le attività</a><a href="/partecipa/#segnalazioni">Segnala o correggi una scheda</a></nav></details>
    </div></header>
    <main id="contenuto"><slot /></main>
    {Astro.url.pathname !== '/orologiaio/' && <a class="atlas-ai-launch" href="/orologiaio/#assistente" aria-label="Chiedi all’Orologiaio AI: trova il servizio giusto"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-8 8 8 8 0 0 1-3.2-.7L4 20l1.2-4.8A8 8 0 1 1 20 11.5Z"/><path d="m12 7 1.1 3.4 3.4 1.1-3.4 1.1-1.1 3.4-1.1-3.4-3.4-1.1 3.4-1.1L12 7Z"/></svg><span><strong>Chiedi all’Orologiaio AI</strong><small>Ti aiuto a scegliere il servizio</small></span></a>}
    <dialog id="atlas-favorites" aria-labelledby="atlas-favorites-title"><header><h2 id="atlas-favorites-title">Le tue orologerie</h2><button type="button" data-atlas-close aria-label="Chiudi preferiti">×</button></header><p class="small muted">Salva le attività che ti interessano e selezionane fino a tre per confrontarle. Nessun account necessario.</p><p class="small" data-atlas-notice role="status"></p><div data-atlas-list></div><button type="button" class="btn" data-atlas-compare hidden>Confronta selezionate</button><div data-atlas-comparison></div></dialog>
    <script src="../scripts/saved-activities.ts"></script>
    <footer class="site-footer"><div class="container footer-grid"><div><a class="brand" href="/">orologiai<span>.it</span></a><p>L’atlante delle botteghe e dei laboratori italiani.<br />Storie, servizi e indirizzi da esplorare.</p></div><div><a href="/metodo/">Fonti e metodo di verifica</a><br /><a href="/partecipa/">Inserimenti e correzioni</a><br /><a href="/orologerie/">Esplora i territori</a><br /><a href="/privacy/">Privacy</a> · <a href="/cookie-policy/">Cookie policy</a> · <a href="/note-legali/">Note legali</a> · <a href="/crediti/">Crediti immagini</a></div><p class="small">Guida indipendente · Italia<br />Le informazioni storiche non certificano l’operatività attuale.<br />© {new Date().getFullYear()} Orologiai.it</p></div></footer>
  </body>
</html>
<style is:global>
  .mobile-nav { display: none; }
  @media (max-width: 700px) {
    .site-header .bar { min-height: 64px; padding-block: 8px; justify-content: space-between; flex-wrap: nowrap; position: relative; }
    .site-header .brand { font-size: 1.55rem; }
    .site-header .brand-mark { font-size: 1.8rem; }
    .site-header .desktop-nav { display: none; }
    .mobile-nav { display: block; }
    .mobile-nav summary { list-style: none; min-height: 44px; display: flex; gap: 9px; align-items: center; font-size: .8rem; font-weight: 700; }
    .mobile-nav summary::-webkit-details-marker { display: none; }
    .mobile-nav summary span { font-size: 1rem; }
    .mobile-nav nav { position: absolute; z-index: 50; top: 100%; right: 0; background: #fffefa; border: 1px solid #d8ded4; box-shadow: 0 12px 25px #0002; width: min(290px, calc(100vw - 32px)); display: flex; flex-direction: column; align-items: stretch; gap: 0; padding: 10px 18px; }
    .mobile-nav nav a { font-size: .9rem; padding: 12px 0; }
  }
</style>

<style is:global>
  @font-face{font-family:"Atlas Serif";src:url("/fonts/DejaVuSerif.woff") format("woff");font-weight:400;font-style:normal;font-display:swap}
  .atlas-v4{--ink:#172f29;--green:#172f29;--paper:#f5f1e7;--white:#fffdf7;--muted:#53675d;--line:#d7d7c9;--soft:#e4eae0;--gold:#805b2e;--atlas-gold:#c5ab7c;--radius:8px;background:var(--paper);color:var(--ink)}
  .atlas-v4 h1,.atlas-v4 h2,.atlas-v4 h3{font-family:"Atlas Serif",Georgia,serif}
  .atlas-v4 .site-header{background:#f5f1e7;border-bottom:1px solid #d8d4c7}
  .atlas-v4 .site-header .bar{width:min(1392px,calc(100% - 64px));min-height:86px;gap:22px}
  .atlas-v4 .site-header .brand{display:inline-flex;align-items:center;gap:11px;padding:0;color:#172f29;font-weight:400;letter-spacing:0;line-height:1;flex-shrink:0;text-decoration:none}
  .atlas-v4 .site-header .brand:after{display:none}
  .atlas-brand-dial{flex:none;color:#957344}
  .atlas-v4 .site-header .atlas-wordmark{font:400 1.7rem/1 "Atlas Serif",Georgia,serif;letter-spacing:-.055em;color:#172f29}
  .atlas-wordmark>span{font-size:.68em;color:#80603a}
  .atlas-wordmark small{display:block;font:700 .47rem/1.3 system-ui,sans-serif;letter-spacing:.16em;margin-top:7px;color:#675638}
  .atlas-v4 .site-header .desktop-nav{gap:clamp(9px,1.3vw,23px);flex-wrap:nowrap}
  .atlas-v4 .site-header .desktop-nav>a{font-size:.79rem;white-space:nowrap;color:#172f29}
  .atlas-v4 .site-header .desktop-nav .nav-cta{background:#172f29;color:#fffdf7;border-color:#172f29;border-radius:4px;padding:12px 16px}
  .atlas-v4 .btn{background:#172f29;color:#fffdf7;border-radius:5px}
  .atlas-v4 .btn:hover{background:#315b48;color:#fffdf7}
  .atlas-v4 .btn-ghost{background:transparent;color:#172f29;border-color:#86988a}
  .atlas-v4 .site-footer{background:#172f29;color:#e8e7dc;padding-block:45px}
  .atlas-v4 .site-footer a{color:#e9d4ac}
  .atlas-v4 .site-footer .brand{color:#fffdf7}
  @media(max-width:1050px){.atlas-v4 .site-header .desktop-nav{display:none}.atlas-v4 .site-header .mobile-nav{display:block}.atlas-v4 .site-header .bar{position:relative;flex-wrap:nowrap}.atlas-v4 .mobile-nav summary{list-style:none;min-height:44px;display:flex;gap:9px;align-items:center;font-size:.83rem;font-weight:700}.atlas-v4 .mobile-nav nav{position:absolute;z-index:50;top:100%;right:0;background:#fffdf7;border:1px solid #d7d7c9;box-shadow:0 12px 28px #0002;width:min(300px,calc(100vw - 32px));display:flex;flex-direction:column;align-items:stretch;gap:0;padding:10px 18px}.atlas-v4 .mobile-nav nav a{padding:12px 0}}
  @media(max-width:700px){.atlas-v4 .site-header .bar{width:calc(100% - 36px);min-height:68px}.atlas-brand-dial{width:30px;height:30px}.atlas-v4 .site-header .atlas-wordmark{font-size:1.36rem}.atlas-wordmark small{font-size:.4rem}.atlas-v4 .site-footer{padding-block:30px}}
  @media(prefers-reduced-motion:reduce){.atlas-v4 *{scroll-behavior:auto!important}}
</style>

<style is:global>
.atlas-favorites-launch{position:fixed;right:16px;bottom:max(16px,env(safe-area-inset-bottom));z-index:40;background:#172f29;color:#fffdf7;border:1px solid #c5ab7c;border-radius:24px;padding:11px 17px;min-height:44px;font-weight:700;box-shadow:0 5px 18px #0003}#atlas-favorites{width:min(920px,calc(100vw - 24px));max-height:85vh;padding:24px;background:#fffdf7;border:1px solid #d7d7c9;color:#172f29;border-radius:10px;overflow:auto}#atlas-favorites::backdrop{background:#172f29aa}#atlas-favorites header{display:flex;justify-content:space-between;align-items:center;gap:16px}#atlas-favorites h2{margin:0 0 8px}#atlas-favorites button:not(.btn),.atlas-save{min-height:44px;border:1px solid #8ca497;background:#fffdf7;color:#172f29;border-radius:5px;padding:8px 12px;font-size:.82rem;font-weight:700}.atlas-save[aria-pressed=true]{background:#e4eae0}.atlas-saved-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid #d7d7c9}.atlas-saved-row label{flex:1;display:flex;align-items:center;gap:9px;min-width:0}.atlas-saved-row input{width:20px;height:20px;flex:none}.atlas-compare-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr));gap:12px}.atlas-compare-card{border:1px solid #d7d7c9;padding:16px;border-radius:5px;overflow-wrap:anywhere}.atlas-compare-card h3{font-size:1.4rem}.atlas-compare-card dt{font-weight:700;font-size:.8rem;margin-top:10px}.atlas-compare-card dd{margin:0;font-size:.85rem}.atlas-v4 .result-actions{flex-wrap:wrap}.atlas-v4 .result-actions .atlas-save{flex:0 0 auto}.atlas-profile-identity .atlas-save{background:transparent;color:#fffdf7}.atlas-profile-identity .atlas-save[aria-pressed=true]{background:#e4eae0;color:#172f29}@media(max-width:700px){#atlas-favorites{padding:16px}.atlas-compare-grid{grid-template-columns:1fr}.atlas-v4 .result-actions .atlas-save{flex:1 1 100%;margin-top:4px}.atlas-saved-row{gap:7px}}
</style>

<style is:global>@media(max-width:700px){.atlas-favorites-launch{max-width:calc(100vw - 24px);font-size:.8rem;min-height:44px}.atlas-v4:has(.atlas-favorites-launch:not([hidden])) .site-footer{padding-bottom:84px}}</style>

<style is:global>
.atlas-v4 .atlas-favorites-menu{position:static;display:inline-flex;align-items:center;gap:5px;background:none;color:inherit;border:0;padding:10px 0;font-size:.79rem;font-weight:650;min-height:44px;white-space:nowrap;box-shadow:none;text-align:left}
.atlas-v4 .atlas-favorites-menu:hover{text-decoration:underline}
.atlas-v4 .atlas-ai-launch{position:fixed;bottom:max(18px,env(safe-area-inset-bottom));right:18px;z-index:40;display:flex;align-items:center;gap:11px;padding:12px 17px;min-height:54px;max-width:calc(100vw - 36px);background:#172f29;border:1px solid #80988a;color:#fffdf7;text-decoration:none;border-radius:30px;box-shadow:0 6px 20px #2223}
.atlas-v4.atlas-edition .atlas-ai-launch{background:#792e32;border-color:#792e32;color:#fffefa}
.atlas-ai-launch svg{flex:none}.atlas-ai-launch span{display:grid;gap:2px}.atlas-ai-launch strong{font:700 .83rem/1.25 system-ui,sans-serif}.atlas-ai-launch small{font:400 .7rem/1.3 system-ui,sans-serif;color:inherit;opacity:.94}.atlas-ai-launch:hover{filter:brightness(1.1)}
.atlas-v4:has(.atlas-ai-launch) .site-footer{padding-bottom:100px}
#assistente{scroll-margin-top:20px}
@media(max-width:1050px){.atlas-v4 .mobile-nav .atlas-favorites-menu{width:100%;padding:12px 0;font-size:.9rem}}
@media(max-width:700px){.atlas-v4 .atlas-ai-launch{right:12px;bottom:max(12px,env(safe-area-inset-bottom));padding:10px 14px;gap:8px}.atlas-ai-launch strong{font-size:.78rem}.atlas-ai-launch small{font-size:.65rem}}
</style>

<style is:global>.atlas-v4 .atlas-ai-launch:focus-visible{outline:3px solid #b7681c;outline-offset:4px}.atlas-v4 .site-footer .footer-grid p{color:#e1d9ce}.atlas-v4 .atlas-ai-launch{max-width:calc(100vw - 24px)}@media(max-width:1200px){.atlas-v4 .site-header .desktop-nav{display:none}.atlas-v4 .site-header .mobile-nav{display:block}.atlas-v4 .site-header .bar{justify-content:space-between;position:relative;flex-wrap:nowrap}.atlas-v4 .mobile-nav summary{list-style:none;min-height:44px;display:flex;align-items:center;gap:8px;font-weight:700}.atlas-v4 .mobile-nav nav{position:absolute;right:0;top:100%;z-index:50;display:flex;flex-direction:column;align-items:stretch;gap:0;background:#fffefa;border:1px solid #ded8cd;padding:10px 16px;width:min(300px,calc(100vw - 32px));box-shadow:0 12px 25px #0002}.atlas-v4 .mobile-nav nav a{padding:12px 0}}@media(max-width:350px){.atlas-v4 .site-header .brand{gap:7px}.atlas-v4 .site-header .atlas-wordmark{font-size:1.15rem}.atlas-wordmark small{font-size:.36rem}.atlas-brand-dial{width:26px;height:26px}}</style>
